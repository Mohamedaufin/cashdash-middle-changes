{
  "rules": {
    "status": {
      "$userEmail": {
        // Owner can read their own presence; admins can read any for the admin panel.
        ".read": "auth != null && (auth.token.email.replace('.', ',') === $userEmail || root.child('admins').child(auth.token.email.replace('.', ',')).exists() || auth.token.email === 'mohamedaufin64@gmail.com' || auth.token.email === 'arunbhalaji200904@gmail.com')",
        // Only the owner of this status node can write their own presence.
        ".write": "auth != null && auth.token.email.replace('.', ',') === $userEmail",
        ".validate": "newData.hasChildren()"
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
