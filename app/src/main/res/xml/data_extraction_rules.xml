<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31) backup / transfer rules.

    This app stores financial data locally: wallet balances, transaction history,
    the last scanned UPI URI, and a cached admin-permission blob. None of it
    benefits from being backed up — everything authoritative lives in Firestore
    and re-syncs on sign-in — so both channels are excluded outright.

    android:allowBackup="false" already disables cloud backup; these explicit
    excludes also cover Android 12+ device-to-device transfer, which is governed
    separately, and make the intent legible instead of relying on a default.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>

    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
