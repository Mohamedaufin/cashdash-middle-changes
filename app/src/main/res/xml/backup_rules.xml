<?xml version="1.0" encoding="utf-8"?>
<!--
    Pre-Android 12 (API < 31) auto-backup rules.

    Same intent as data_extraction_rules.xml: nothing local is worth backing up,
    and it includes financial data plus a cached admin-permission blob, so the
    whole app sandbox is excluded. Authoritative state re-syncs from Firestore.

    Covers: AppPrefs (email/name/phone/dob), WalletPrefs, LocalScanPrefs
    (last_upi), admin_perms_cache, and the cashdash_database Room DB.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
