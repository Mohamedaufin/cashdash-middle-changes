<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="10dp"
    android:layout_margin="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="?attr/mainBackground">

        <!-- Header with Close Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@mipmap/ic_launcher"
                android:layout_centerVertical="true"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CashDash Tracker"
                android:textColor="?attr/textPrimaryColor"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginStart="32dp"
                android:layout_centerVertical="true"/>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnClose"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?attr/inputBackground"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                app:tint="?attr/textPrimaryColor"/>
        </RelativeLayout>

        <!-- Toggle Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="?attr/inputBackground"
            android:padding="12dp"
            android:gravity="center_vertical">
            
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TapTrack"
                android:textColor="?attr/textPrimaryColor"
                android:textStyle="bold"/>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchTracking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/switch_thumb_color"
                app:trackTint="@color/switch_track_color"
                app:track="@drawable/custom_switch_track_base"/>
        </LinearLayout>

        <!-- Tracker Body (Hidden if toggle is off) -->
        <LinearLayout
            android:id="@+id/trackerBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="16dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvWalletHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wallet: ₹0 / ₹0"
                android:textColor="?attr/textSecondaryColor"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="end"
                android:layout_marginBottom="4dp"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/edtTitle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Expense Title (e.g. Swiggy Order)"
                android:textColorHint="@color/text_dim"
                android:textColor="?attr/textPrimaryColor"
                android:background="?attr/inputBackground"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="12dp"
                android:singleLine="true"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/edtAmount"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Amount"
                android:inputType="numberDecimal"
                android:maxLength="7"
                android:textColorHint="@color/text_dim"
                android:textColor="?attr/textPrimaryColor"
                android:background="?attr/inputBackground"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="12dp"
                android:singleLine="true"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Allocation"
                android:textColor="?attr/textSecondaryColor"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:id="@+id/layoutAllocationBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="?attr/inputBackground"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvSelectedAllocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Select Allocation"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imgAllocationArrow"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_drop_down"
                    app:tint="?attr/textPrimaryColor" />
            </LinearLayout>

            <!-- Expandable Options Container -->
            <LinearLayout
                android:id="@+id/layoutAllocationExpandable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?attr/inputBackground"
                android:layout_marginTop="4dp"
                android:visibility="gone">
                <!-- Dynamically populated options go here -->
            </LinearLayout>

            <TextView
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="Save Expense"
                android:textColor="?attr/textPrimaryColor"
                android:background="?attr/inputBackground"
                android:gravity="center"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
