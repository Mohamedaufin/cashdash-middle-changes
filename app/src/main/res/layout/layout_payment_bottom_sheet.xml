<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/mainBackground"
    android:padding="24dp"
    android:clipToPadding="false">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#40FFFFFF"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/tvReceiverInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Receiver: Unknown\nUPI ID: Unknown"
        android:textSize="@dimen/text_subhead"
        android:textColor="?attr/textPrimaryColor"
        android:layout_marginBottom="20dp" />

    <EditText
        android:id="@+id/etPaymentAmount"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:hint="Enter Amount"
        android:textColorHint="?attr/textMutedColor"
        android:textColor="?attr/textPrimaryColor"
        android:textSize="@dimen/text_title"
        android:inputType="numberDecimal"
        android:maxLength="7"
        android:background="?attr/inputBackground"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="20dp" />

    <!-- Allocation Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/tvAllocationLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="No allocation selected"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/text_subhead" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnChooseAllocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Change"
            android:textColor="?attr/textPrimaryColor"
            android:textAllCaps="false"
            android:background="?attr/cardBackground"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:paddingHorizontal="15dp" />
    </LinearLayout>

    <!-- Payment Buttons Container -->
    <LinearLayout
        android:id="@+id/paymentActionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginBottom="15dp"
        android:weightSum="2">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPayCred"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="Cred"
            android:textColor="?attr/textPrimaryColor"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="?attr/cardBackground"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:layout_marginEnd="8dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPayGPay"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="GPay"
            android:textColor="?attr/textPrimaryColor"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="?attr/cardBackground"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvWalletBalance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Wallet Balance: ₹0"
        android:textColor="?attr/textPrimaryColor"
        android:textSize="@dimen/text_body"
        android:gravity="center"
        android:layout_marginBottom="10dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnPayInitiate"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="Pay ₹0"
        android:textColor="?attr/textPrimaryColor"
        android:textSize="@dimen/text_subhead"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:background="?attr/cardBackground"
        android:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:elevation="0dp"
        android:layout_marginBottom="15dp" />

</LinearLayout>
