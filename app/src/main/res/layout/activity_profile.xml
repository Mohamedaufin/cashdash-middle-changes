<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mainBackground"
    android:scrollbars="none"
    android:paddingTop="40dp"
    android:paddingLeft="24dp"
    android:paddingRight="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="35dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="?attr/roundBackground"
                android:src="@drawable/ic_back_arrow1"
                app:tint="?attr/textPrimaryColor"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:layout_alignParentStart="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_alignTop="@id/btnBack"
                android:layout_alignBottom="@id/btnBack"
                android:gravity="center"
                android:text="Edit Profile"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />
        </RelativeLayout>

        <EditText
            android:id="@+id/edtName"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="?attr/inputBackground"
            android:hint="Name"
            android:textColor="?attr/textPrimaryColor"
            android:textColorHint="?attr/textMutedColor"
            android:padding="16dp"
            android:inputType="textPersonName|textCapWords"
            android:layout_marginBottom="20dp"/>

        <EditText
            android:id="@+id/edtPhone"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="?attr/inputBackground"
            android:hint="Phone Number"
            android:textColor="?attr/textPrimaryColor"
            android:textColorHint="?attr/textMutedColor"
            android:padding="16dp"
            android:inputType="phone"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/tvDob"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="?attr/inputBackground"
            android:hint="Date of Birth"
            android:textColor="?attr/textPrimaryColor"
            android:textColorHint="?attr/textMutedColor"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="16sp"
            android:layout_marginBottom="20dp"
            android:clickable="true"
            android:focusable="true"/>

        <EditText
            android:id="@+id/edtEmail"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="?attr/inputBackground"
            android:hint="Email"
            android:textColor="?attr/textPrimaryColor"
            android:textColorHint="?attr/textMutedColor"
            android:padding="16dp"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="20dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="Save"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="@dimen/text_subhead"
            android:background="?attr/cardBackground"
            android:backgroundTint="@null"
            android:textColor="?attr/textPrimaryColor"
            android:foreground="@null"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:layout_marginBottom="25dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnChangePassword"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:background="?attr/cardBackground"
            android:backgroundTint="@null"
            android:text="Change Password"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="@dimen/text_subhead"
            android:textColor="?attr/textPrimaryColor"
            android:foreground="@null"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:layout_marginBottom="25dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="35dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLogout"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="65dp"
                android:text="Logout"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="@dimen/text_body"
                android:layout_marginEnd="8dp"
                android:background="?attr/cardBackground"
                android:backgroundTint="@null"
                android:textColor="#FF4D4D"
                android:foreground="@null"
                android:stateListAnimator="@null"
                android:elevation="0dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDeleteAccount"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="65dp"
                android:text="Delete Account"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="@dimen/text_body"
                android:layout_marginStart="8dp"
                android:background="?attr/cardBackground"
                android:backgroundTint="@null"
                android:textColor="#FF4D4D"
                android:foreground="@null"
                android:stateListAnimator="@null"
                android:elevation="0dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
