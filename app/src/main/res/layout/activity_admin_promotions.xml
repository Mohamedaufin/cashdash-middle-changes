<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mainBackground">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="?attr/roundBackground"
            android:src="@drawable/ic_back_arrow1"
            app:tint="?attr/textPrimaryColor"
            android:padding="10dp"
            android:scaleType="fitCenter"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Promotions"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/textPrimaryColor"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create a rich promotional push notification and announcement simultaneously."
                android:textSize="14sp"
                android:textColor="?attr/textMutedColor"
                android:layout_marginBottom="16dp"/>

            <!-- Notification Details -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Push Notification Details"
                android:textSize="16sp"
                android:textColor="?attr/textPrimaryColor"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/edtNotifTitle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Notification Title (e.g. Huge Update!)"
                android:textColor="?attr/textPrimaryColor"
                android:textColorHint="?attr/textMutedColor"
                android:background="?attr/inputBackground"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/edtNotifBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="80dp"
                android:hint="Notification Body (e.g. Check out the new features)"
                android:textColor="?attr/textPrimaryColor"
                android:textColorHint="?attr/textMutedColor"
                android:background="?attr/inputBackground"
                android:padding="16dp"
                android:gravity="top|start"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"/>

            <!-- Announcement Details -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="In-App Announcement Details"
                android:textSize="16sp"
                android:textColor="?attr/textPrimaryColor"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/edtAnnouncementTitle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Announcement Title"
                android:textColor="?attr/textPrimaryColor"
                android:textColorHint="?attr/textMutedColor"
                android:background="?attr/inputBackground"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/edtAnnouncementBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="120dp"
                android:hint="Full Announcement Details (can be long)"
                android:textColor="?attr/textPrimaryColor"
                android:textColorHint="?attr/textMutedColor"
                android:background="?attr/inputBackground"
                android:padding="16dp"
                android:gravity="top|start"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"/>

            <!-- Media Attachment -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Media &amp; Triggers"
                android:textSize="16sp"
                android:textColor="?attr/textPrimaryColor"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">
                
                <Button
                    android:id="@+id/btnAttachImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Attach Image"
                    android:backgroundTint="?attr/colorAccent"
                    android:textColor="@android:color/white"/>

                <TextView
                    android:id="@+id/tvImageStatus"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="No image attached"
                    android:textColor="?attr/textMutedColor"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="12dp"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </LinearLayout>

            <EditText
                android:id="@+id/edtTriggerText"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Button Text (e.g. Update Now, Open Link)"
                android:textColor="?attr/textPrimaryColor"
                android:textColorHint="?attr/textMutedColor"
                android:background="?attr/inputBackground"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/edtTriggerUrl"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Trigger URL (e.g. https://play.google.com/...)"
                android:textColor="?attr/textPrimaryColor"
                android:textColorHint="?attr/textMutedColor"
                android:background="?attr/inputBackground"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="14sp"
                android:layout_marginBottom="24dp"/>

            <!-- Audience Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Target Audience"
                android:textSize="16sp"
                android:textColor="?attr/textPrimaryColor"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <Spinner
                android:id="@+id/spinnerTargetAudience"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="?attr/inputBackground"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/btnSendPromotions"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Send Promotion"
                android:backgroundTint="?attr/colorAccent"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="32dp"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
