<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="?attr/mainBackground">

    <!-- Header -->
    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="?attr/roundBackground"
            android:src="@drawable/ic_back_arrow1"
            app:tint="?attr/textPrimaryColor"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:layout_alignParentStart="true"/>

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/btnBack"
            android:layout_alignParentStart="true"
            android:layout_marginTop="16dp"
            android:text="New Message"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="24sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="25dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Title"
                android:textSize="@dimen/text_subhead"
                android:textColor="?attr/textPrimaryColor"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/edtMessageTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/inputBackground"
                android:padding="15dp"
                android:hint="Title"
                android:textColorHint="?attr/textMutedColor"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="@dimen/text_body"
                android:layout_marginBottom="15dp"
                android:inputType="textCapSentences"
                android:singleLine="true"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Content"
                android:textSize="@dimen/text_subhead"
                android:textColor="?attr/textPrimaryColor"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/edtMessageBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/inputBackground"
                android:padding="15dp"
                android:hint="Write your message here..."
                android:textColorHint="?attr/textMutedColor"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="@dimen/text_body"
                android:layout_marginBottom="16dp"
                android:gravity="top|start"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="5"/>

            <!-- Supporting Media Section -->
            <TextView
                android:id="@+id/tvMediaLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add Supporting Media"
                android:textSize="@dimen/text_subhead"
                android:textColor="?attr/textPrimaryColor"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add image for notification and announcement (optional)"
                android:textColor="?attr/textMutedColor"
                android:textSize="13sp"
                android:layout_marginBottom="10dp"
                android:lineSpacingExtra="2dp"/>

            <!-- Horizontally scrollable photo strip -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="25dp">

                <LinearLayout
                    android:id="@+id/llMediaStrip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>

            </HorizontalScrollView>




            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Target Audience"
                android:textSize="@dimen/text_subhead"
                android:textColor="?attr/textPrimaryColor"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <!-- Target Tabs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">
                
                <TextView
                    android:id="@+id/tabGlobal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="55dp"
                    android:text="Global"
                    android:gravity="center"
                    android:background="?attr/roundBackground"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:id="@+id/tabAdmin"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="55dp"
                    android:text="Admin Only"
                    android:gravity="center"
                    android:background="?attr/roundBackground"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tabUser"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="55dp"
                    android:text="User Specific"
                    android:gravity="center"
                    android:background="?attr/roundBackground"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:id="@+id/tabAge"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="55dp"
                    android:text="Age Specific"
                    android:gravity="center"
                    android:background="?attr/roundBackground"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvTargetDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This will be sent to all users."
                android:textColor="?attr/textMutedColor"
                android:textSize="14sp"
                android:layout_marginBottom="20dp"/>

            <Button
                android:id="@+id/btnSendInline"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Send Globally"
                android:textColor="@android:color/white"
                android:backgroundTint="#008000"
                android:textStyle="bold"
                android:textSize="16sp"
                app:cornerRadius="100dp"
                android:layout_marginBottom="20dp"
                android:visibility="gone"/>

            <!-- Dynamic Containers -->

            <!-- Age Inputs (Visible only on Age Tab) -->
            <LinearLayout
                android:id="@+id/layoutAgeSpecific"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <EditText
                        android:id="@+id/edtMinAge"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:hint="Min Age"
                        android:textColor="?attr/textPrimaryColor"
                        android:textColorHint="?attr/textMutedColor"
                        android:background="?attr/inputBackground"
                        android:padding="15dp"
                        android:inputType="number"
                        android:layout_marginEnd="10dp"/>

                    <EditText
                        android:id="@+id/edtMaxAge"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:hint="Max Age"
                        android:textColor="?attr/textPrimaryColor"
                        android:textColorHint="?attr/textMutedColor"
                        android:background="?attr/inputBackground"
                        android:padding="15dp"
                        android:inputType="number"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/btnFetchUsers"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="Fetch Users"
                    android:textColor="?attr/textPrimaryColor"
                    android:background="?attr/roundBackground"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- User List Container (Visible on User & Age Tabs) -->
            <LinearLayout
                android:id="@+id/layoutUserList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/edtSearchUsers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Search user email or name..."
                    android:textColor="?attr/textPrimaryColor"
                    android:textColorHint="?attr/textMutedColor"
                    android:background="?attr/inputBackground"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:layout_marginBottom="12dp"/>
                    
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:layout_marginBottom="8dp">
                    <CheckBox
                        android:id="@+id/cbSelectAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select All Fetched Users"
                        android:textColor="?attr/textPrimaryColor"
                        android:textSize="14sp"
                        android:paddingStart="8dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="?attr/inputBackground"
                    android:padding="10dp">
                    
                    <TextView
                        android:id="@+id/tvEmptyList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No users found."
                        android:textColor="?attr/textMutedColor"
                        android:gravity="center"
                        android:padding="20dp"
                        android:visibility="visible"/>

                    <!-- Users will be injected here dynamically -->
                    <LinearLayout
                        android:id="@+id/layoutUsersInner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>
                        
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="?attr/mainBackground"
        android:elevation="10dp">

        <Button
            android:id="@+id/btnSend"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Send Global"
            android:textColor="@android:color/white"
            android:backgroundTint="#008000"
            android:textStyle="bold"
            android:textSize="16sp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
