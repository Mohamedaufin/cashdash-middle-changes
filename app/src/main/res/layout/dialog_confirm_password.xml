<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="28dp"
    android:paddingEnd="28dp"
    android:paddingBottom="24dp"
    android:gravity="center_horizontal"
    android:background="?attr/transactionItemBackground">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Confirm Password"
        android:textColor="?attr/textPrimaryColor"
        android:textSize="@dimen/text_title"
        android:textStyle="bold"
        android:paddingBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Please enter your password to confirm account deletion."
        android:textColor="?attr/textMutedColor"
        android:textSize="@dimen/text_body"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/edtConfirmPassword"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="?attr/inputBackground"
        android:hint="Password"
        android:textColor="?attr/textPrimaryColor"
        android:textColorHint="?attr/textMutedColor"
        android:inputType="textPassword"
        android:padding="16dp"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/text_subhead"
            android:background="?attr/cardBackground"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:layout_marginEnd="8dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConfirm"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:text="Confirm"
            android:textAllCaps="false"
            android:textColor="#FF4D4D"
            android:textSize="@dimen/text_subhead"
            android:textStyle="bold"
            android:background="?attr/cardBackground"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>

