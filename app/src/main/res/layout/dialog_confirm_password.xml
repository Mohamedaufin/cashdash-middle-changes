<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="28dp"
    android:gravity="center_horizontal"
    android:background="?attr/transactionItemBackground">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Confirm Password"
        android:textColor="?attr/textPrimaryColor"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Please enter your password to confirm account deletion."
        android:textColor="?attr/textMutedColor"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/edtConfirmPassword"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="?attr/inputBackground"
        android:hint="Password"
        android:textColor="?attr/textPrimaryColor"
        android:textColorHint="?attr/textMutedColor"
        android:inputType="textPassword"
        android:padding="16dp"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="?attr/textPrimaryColor"
            android:background="?attr/inputBackground"
            app:backgroundTint="@null"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnConfirm"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:text="Confirm"
            android:textColor="?attr/textPrimaryColor"
            android:textStyle="bold"
            android:background="?attr/glass3dRedBackground"
            app:backgroundTint="@null"
            android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>

