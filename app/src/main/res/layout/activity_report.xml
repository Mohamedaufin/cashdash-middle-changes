<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/reportRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mainBackground">

    <!-- TOP BAR — default paddingTop prevents status bar overlap before insets fire -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="80dp"
        android:paddingBottom="10dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true"
            android:background="?attr/roundBackground"
            android:padding="12dp"
            android:src="@drawable/ic_back_arrow1"
            app:tint="?attr/textPrimaryColor"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Financial Report"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:letterSpacing="0.05"/>
    </RelativeLayout>

    <!-- SELECTORS -->
    <LinearLayout
        android:id="@+id/selectors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:checkedButton="@+id/btnMonthly">

            <Button
                android:id="@+id/btnWeekly"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Weekly"
                android:textAllCaps="false"
                android:textColor="?attr/textPrimaryColor"
                app:strokeColor="?attr/textMutedColor"/>

            <Button
                android:id="@+id/btnMonthly"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Monthly"
                android:textAllCaps="false"
                android:textColor="?attr/textPrimaryColor"
                app:strokeColor="?attr/textMutedColor"/>
            <Button
                android:id="@+id/btnCustom"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Custom"
                android:textAllCaps="false"
                android:textColor="?attr/textPrimaryColor"
                app:strokeColor="?attr/textMutedColor"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPeriodSelect"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="?attr/cardBackground"
            android:text="April 2026"
            android:textAllCaps="false"
            android:textColor="?attr/textPrimaryColor"
            android:drawableEnd="@drawable/ic_glass_menu_vector"
            android:paddingHorizontal="20dp"
            android:stateListAnimator="@null"
            android:elevation="0dp"/>

        <LinearLayout
            android:id="@+id/layoutCustomDates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="18dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start Date"
                    android:textColor="?attr/textMutedColor"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp"/>
                
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCustomStart"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="?attr/cardBackground"
                    android:text="Select"
                    android:textAllCaps="false"
                    android:textColor="?attr/textPrimaryColor"
                    android:stateListAnimator="@null"
                    android:elevation="0dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="End Date"
                    android:textColor="?attr/textMutedColor"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp"/>
                
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCustomEnd"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="?attr/cardBackground"
                    android:text="Select"
                    android:textAllCaps="false"
                    android:textColor="?attr/textPrimaryColor"
                    android:stateListAnimator="@null"
                    android:elevation="0dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- FIXED DOWNLOAD BUTTON AT BOTTOM -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDownloadFinal"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="⬇  Download Report"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/text_subhead"
        android:textStyle="bold"
        android:backgroundTint="#7C5CFC"
        app:cornerRadius="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:elevation="16dp"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- VIEWPAGER2 SCROLL CONTENT (constrained above download bar) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/btnDownloadFinal"
        app:layout_constraintTop_toBottomOf="@id/selectors" />



</androidx.constraintlayout.widget.ConstraintLayout>
