<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mainBackground"
    android:fitsSystemWindows="true">

    <!-- TOP BAR (Standardized to FinMinder pattern) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/roundBackground"
            android:padding="12dp"
            android:src="@drawable/ic_back_arrow1"
            app:tint="?attr/textPrimaryColor"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:text="Wallet balance"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvCurrentBalance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Current balance: ₹0"
        android:textColor="?attr/textMutedColor"
        android:textSize="@dimen/text_subhead"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/ivEditBalance"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_pencil"
        app:tint="#B0C8FF"
        android:background="@null"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toEndOf="@id/tvCurrentBalance"
        app:layout_constraintTop_toTopOf="@id/tvCurrentBalance"
        app:layout_constraintBottom_toBottomOf="@id/tvCurrentBalance"/>

    <!-- AMOUNT DISPLAY BOX -->
    <LinearLayout
        android:id="@+id/inputArea"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginHorizontal="25dp"
        android:layout_marginTop="40dp"
        android:background="?attr/cardBackground"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tvCurrentBalance">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/text_headline"
            android:textStyle="bold"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/text_headline"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ACTION BUTTONS (ADD / REPLACE) -->
    <LinearLayout
        android:id="@+id/actionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginHorizontal="25dp"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintTop_toBottomOf="@id/inputArea">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAdd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="65dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="?attr/cardBackground"
            android:backgroundTint="@null"
            android:text="Add to current balance"
            android:textAllCaps="false"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            android:padding="8dp"
            android:stateListAnimator="@null"
            android:elevation="0dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnReplace"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="65dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="?attr/cardBackground"
            android:backgroundTint="@null"
            android:text="Replace total balance"
            android:textAllCaps="false"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            android:padding="8dp"
            android:stateListAnimator="@null"
            android:elevation="0dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hintRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="25dp"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintTop_toBottomOf="@id/actionRow">

        <TextView
            android:id="@+id/tvAddHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text=""
            android:textColor="?attr/textMutedColor"
            android:textSize="11sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvReplaceHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text=""
            android:textColor="?attr/textMutedColor"
            android:textSize="11sp"
            android:gravity="center" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvChooseLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose how to update your wallet balance"
        android:textColor="?attr/textMutedColor"
        android:gravity="center"
        android:textSize="@dimen/text_body"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/hintRow"/>

    <!-- NUMPAD CONTAINER -->
    <FrameLayout
        android:id="@+id/numpadContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="?attr/panelBackground"
        android:layout_marginTop="80dp"
        android:paddingTop="20dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toBottomOf="@id/actionRow"
        app:layout_constraintBottom_toBottomOf="parent">

        <GridLayout
            android:id="@+id/numberPad"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alignmentMode="alignMargins"
            android:columnCount="3"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:rowCount="4"
            android:useDefaultMargins="true">

            <androidx.appcompat.widget.AppCompatButton style="@style/keyBtn" android:text="1"/>
            <androidx.appcompat.widget.AppCompatButton style="@style/keyBtn" android:text="2"/>
            <androidx.appcompat.widget.AppCompatButton style="@style/keyBtn" android:text="3"/>

            <androidx.appcompat.widget.AppCompatButton style="@style/keyBtn" android:text="4"/>
            <androidx.appcompat.widget.AppCompatButton style="@style/keyBtn" android:text="5"/>
            <androidx.appcompat.widget.AppCompatButton style="@style/keyBtn" android:text="6"/>

            <androidx.appcompat.widget.AppCompatButton style="@style/keyBtn" android:text="7"/>
            <androidx.appcompat.widget.AppCompatButton style="@style/keyBtn" android:text="8"/>
            <androidx.appcompat.widget.AppCompatButton style="@style/keyBtn" android:text="9"/>

            <androidx.appcompat.widget.AppCompatButton style="@style/keyBtn" android:text="00" />
            <androidx.appcompat.widget.AppCompatButton style="@style/keyBtn" android:text="0"/>
            <androidx.appcompat.widget.AppCompatButton style="@style/keyBtn" android:id="@+id/btnBackspace" android:text="✖" android:textSize="@dimen/text_title"/>

        </GridLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
