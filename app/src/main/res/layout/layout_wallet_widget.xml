<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/walletWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_widget_layered_outer"
        android:padding="3dp"
        android:layout_marginHorizontal="6dp"
        android:layout_marginVertical="6dp">

        <LinearLayout
            android:id="@+id/widgetCapsule"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_widget_capsule"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Empty / Placeholder State -->
            <TextView
                android:id="@+id/tvEmptyState"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="No finminders today"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:visibility="gone" />

            <!-- Left arrow -->
            <ImageView
                android:id="@+id/btnPrev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back_arrow1"
                app:tint="#FFFFFF"
                android:padding="8dp"
                android:layout_marginEnd="4dp"
                android:visibility="gone" />

            <!-- Finminder Details -->
            <LinearLayout
                android:id="@+id/layoutContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <!-- Dynamic Spacer Left -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <!-- Left Column (Title & Type) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"
                    android:orientation="vertical">
                    
                    <TextView
                        android:id="@+id/tvWidgetTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="130dp"
                        android:text="Grocery"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:ellipsize="end"
                        android:maxLines="1" />
                        
                    <TextView
                        android:id="@+id/tvWidgetType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cash out"
                        android:textColor="#AAAAAA"
                        android:textSize="12sp"
                        android:maxLines="1" />
                </LinearLayout>

                <!-- Dynamic Spacing Middle -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5" />

                <!-- Middle Column (Amount & Frequency) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"
                    android:orientation="vertical"
                    android:gravity="center">
                    
                    <TextView
                        android:id="@+id/tvWidgetAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹100"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                        
                    <TextView
                        android:id="@+id/tvWidgetFrequency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Monthly"
                        android:textColor="#AAAAAA"
                        android:textSize="12sp"
                        android:maxLines="1" />
                </LinearLayout>

                <!-- Dynamic Spacing Right -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- Right arrow -->
            <ImageView
                android:id="@+id/btnNext"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back_arrow1"
                android:rotation="180"
                app:tint="#FFFFFF"
                android:padding="8dp"
                android:layout_marginStart="4dp"
                android:visibility="gone" />

            <!-- Logo -->
            <ImageView
                android:id="@+id/imgWidgetLogo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:src="@mipmap/ic_launcher"
                android:scaleType="fitCenter" />

        </LinearLayout>
    </FrameLayout>

</FrameLayout>
