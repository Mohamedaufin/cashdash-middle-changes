<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mainBackground">

    <!-- Scrollable container for Page 1 -->
    <ScrollView
        android:id="@+id/rigorScrollPage1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/roundBackground"
                android:padding="12dp"
                android:src="@drawable/ic_back_arrow1"
                app:tint="?attr/textPrimaryColor"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="32dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="@+id/tvRigorTitle"/>

            <TextView
                android:id="@+id/tvRigorTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rigor Tracker"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"
                android:layout_marginTop="32dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvKeepTrack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Keep Track of Expenses"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"
                android:layout_marginTop="40dp"
                app:layout_constraintTop_toBottomOf="@id/tvRigorTitle"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter the details below to manually record your expense."
                android:textColor="?attr/textMutedColor"
                android:textSize="@dimen/text_body"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/tvKeepTrack"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/Title"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:hint="Title of Expense"
                android:textColor="?attr/textPrimaryColor"
                android:textColorHint="@color/text_dim"
                android:padding="16dp"
                android:inputType="textCapSentences|textAutoCorrect"
                android:background="?attr/inputBackground"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/tvDescription"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <EditText
                android:id="@+id/inputAmount"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:hint="Enter amount"
                android:textColor="?attr/textPrimaryColor"
                android:textColorHint="@color/text_dim"
                android:padding="16dp"
                android:inputType="number"
                android:maxLength="7"
                android:background="?attr/inputBackground"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/Title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/txtDateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Expense Date"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="@dimen/text_subhead"
                android:textStyle="bold"
                android:layout_marginTop="32dp"
                app:layout_constraintTop_toBottomOf="@id/inputAmount"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- CALENDAR VIEW WRAPPER -->
            <FrameLayout
                android:id="@+id/calendarWrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/rigorCalendarBackground"
                android:padding="10dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                app:layout_constraintTop_toBottomOf="@id/txtDateLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <CalendarView
                    android:id="@+id/calendarExpense"
                    android:theme="?attr/calendarTheme"
                    android:layout_width="match_parent"
                    android:layout_height="353dp"
                    android:background="@null" />
            </FrameLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="40dp"
                android:background="?attr/cardBackground"
                android:backgroundTint="@null"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="Next"
                android:textAllCaps="false"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="@dimen/text_subhead"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/calendarWrapper"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Page 2 Content (Hidden initially) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rigorPage2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:padding="24dp">

        <TextView
            android:id="@+id/headingChoose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose Expense Allocation"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:layout_marginTop="48dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <ScrollView
            android:id="@+id/categoryScroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:paddingBottom="50dp"
            app:layout_constraintTop_toBottomOf="@id/headingChoose"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/categoryListContainer"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
