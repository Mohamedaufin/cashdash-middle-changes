<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mainBackground"
    android:fitsSystemWindows="true">

    <!-- Fixed Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rigorHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/roundBackground"
            android:padding="12dp"
            android:src="@drawable/ic_back_arrow1"
            app:tint="?attr/textPrimaryColor"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/tvRigorTitle"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:text="Rigor Tracker"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable container for Page 1 -->
    <ScrollView
        android:id="@+id/rigorScrollPage1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/rigorHeader"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvKeepTrack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Keep Track of Expenses"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter the details below to manually record your expense."
                android:textColor="?attr/textMutedColor"
                android:textSize="@dimen/text_body"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/tvKeepTrack"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/Title"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:hint="Title of Expense"
                android:textColor="?attr/textPrimaryColor"
                android:textColorHint="@color/text_dim"
                android:padding="16dp"
                android:inputType="textCapSentences|textAutoCorrect"
                android:background="?attr/inputBackground"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/tvDescription"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <EditText
                android:id="@+id/inputAmount"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:hint="Enter amount"
                android:textColor="?attr/textPrimaryColor"
                android:textColorHint="@color/text_dim"
                android:padding="16dp"
                android:inputType="number"
                android:maxLength="7"
                android:background="?attr/inputBackground"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/Title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/txtDateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Expense Date"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="@dimen/text_subhead"
                android:textStyle="bold"
                android:layout_marginTop="32dp"
                app:layout_constraintTop_toBottomOf="@id/inputAmount"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- CALENDAR VIEW WRAPPER -->
            <LinearLayout
                android:id="@+id/calendarWrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?attr/rigorCalendarBackground"
                android:padding="10dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                app:layout_constraintTop_toBottomOf="@id/txtDateLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/btnPrevMonth"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="10dp"
                        android:src="@drawable/ic_back_arrow1"
                        app:tint="?attr/textPrimaryColor"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/tvMonthTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="?attr/textPrimaryColor"
                        android:textSize="@dimen/text_subhead"/>

                    <ImageView
                        android:id="@+id/btnNextMonth"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="10dp"
                        android:rotation="180"
                        android:src="@drawable/ic_back_arrow1"
                        app:tint="?attr/textPrimaryColor"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/weekdayRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="8dp"/>

                <com.kizitonwose.calendar.view.CalendarView
                    android:id="@+id/calendarExpense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cv_dayViewResource="@layout/item_calendar_day"
                    app:cv_orientation="horizontal"
                    app:cv_scrollPaged="true"
                    app:cv_outDateStyle="endOfRow"/>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="40dp"
                android:background="?attr/cardBackground"
                android:backgroundTint="@null"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="Next"
                android:textAllCaps="false"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="@dimen/text_subhead"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/calendarWrapper"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Page 2 Content (Hidden initially) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rigorPage2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/rigorHeader"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/headingChoose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose Expense Allocation"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <ScrollView
            android:id="@+id/categoryScroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:paddingBottom="50dp"
            app:layout_constraintTop_toBottomOf="@id/headingChoose"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/categoryListContainer"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
