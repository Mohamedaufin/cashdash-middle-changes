<?xml version="1.0" encoding="utf-8"?>
<!--
  Page 1: Bold, flagship wallet balance and tentative date setup:
  1. Card with balance box, embedded calendar, and save CTA
  2. Types ₹2000 into balance box
  3. Cursor clicks date 25 on calendar -> Day 25 highlights & confirms "7 Days · till 25 Oct"
  4. Cursor clicks "Save Balance"
  5. Card dissolves into heroic large Wallet Ring with pill badge "This money is tentatively till 25 Oct"
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Container Frame -->
    <FrameLayout
        android:id="@+id/introWalletCanvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- ================= Beat 1: Sleek Setup Card ================= -->
        <LinearLayout
            android:id="@+id/introWalletSetupCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_intro_feature_card"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp">

            <!-- Card Header with Chip Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wallet &amp; Budget Setup"
                        android:textColor="?attr/textPrimaryColor"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Declare what you have and timeline"
                        android:textColor="?attr/textMutedColor"
                        android:textSize="9sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_intro_chip"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="BUDGET"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Section 1: Wallet Balance Input Display -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="WALLET BALANCE"
                android:textColor="?attr/textMutedColor"
                android:textSize="8sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:background="?attr/inputBackground"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:id="@+id/introWalletInputField"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:includeFontPadding="false"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="₹2,000" />
            </FrameLayout>

            <!-- Section 2: Inline Calendar Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TENTATIVELY TILL"
                    android:textColor="?attr/textMutedColor"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/introWalletMonthLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="October 2026"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="?attr/inputBackground"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">

                <!-- Weekday Headers -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="M" android:textColor="?attr/textMutedColor" android:textSize="9sp" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="T" android:textColor="?attr/textMutedColor" android:textSize="9sp" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="W" android:textColor="?attr/textMutedColor" android:textSize="9sp" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="T" android:textColor="?attr/textMutedColor" android:textSize="9sp" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="F" android:textColor="?attr/textMutedColor" android:textSize="9sp" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="S" android:textColor="?attr/textMutedColor" android:textSize="9sp" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="S" android:textColor="?attr/textMutedColor" android:textSize="9sp" android:textStyle="bold" />
                </LinearLayout>

                <!-- Dates Row (19 - 25) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="19" android:textColor="?attr/textPrimaryColor" android:alpha="0.55" android:textSize="10sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="20" android:textColor="?attr/textPrimaryColor" android:alpha="0.55" android:textSize="10sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="21" android:textColor="?attr/textPrimaryColor" android:alpha="0.55" android:textSize="10sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="22" android:textColor="?attr/textPrimaryColor" android:alpha="0.55" android:textSize="10sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="23" android:textColor="?attr/textPrimaryColor" android:alpha="0.55" android:textSize="10sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="24" android:textColor="?attr/textPrimaryColor" android:alpha="0.55" android:textSize="10sp" />

                    <!-- Target Day 25 -->
                    <FrameLayout
                        android:id="@+id/introWalletCalDay25"
                        android:layout_width="0dp"
                        android:layout_height="24dp"
                        android:layout_weight="1">

                        <TextView
                            android:id="@+id/introWalletCalDay25Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="25"
                            android:textColor="?attr/textPrimaryColor"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Selection Status Feedback -->
                <TextView
                    android:id="@+id/introWalletSelectedDateBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:text="Budget duration: 7 Days (till 25 Oct)"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Save CTA Button -->
            <TextView
                android:id="@+id/introWalletSaveBtn"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_intro_cta"
                android:gravity="center"
                android:text="Save Balance"
                android:textColor="?attr/primaryActionText"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ================= Beat 2: Wallet Ring Group ================= -->
        <LinearLayout
            android:id="@+id/introWalletRingGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:alpha="0">

            <!-- Top Tentative Date Pill Badge -->
            <LinearLayout
                android:id="@+id/introWalletTentativeTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_intro_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="16dp"
                android:paddingBottom="7dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_calendar_vector"
                    android:tint="?attr/textPrimaryColor" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="This money is tentatively till 25 Oct"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Heroic 240dp Circular Ring -->
            <FrameLayout
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_gravity="center_horizontal">

                <com.cash.dash.IntroWalletRingView
                    android:id="@+id/introWalletRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/introWalletAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:includeFontPadding="false"
                        android:text="₹2,000"
                        android:textColor="?attr/textPrimaryColor"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/introWalletLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/intro_wallet_label"
                        android:textColor="?attr/textMutedColor"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- ================= Desktop Cursor ================= -->
        <ImageView
            android:id="@+id/introWalletCursor"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:elevation="30dp"
            android:translationZ="30dp"
            android:alpha="0"
            android:contentDescription="@null"
            android:src="@drawable/ic_desktop_cursor" />

    </FrameLayout>
</merge>
