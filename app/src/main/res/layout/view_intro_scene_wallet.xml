<?xml version="1.0" encoding="utf-8"?>
<!--
  Page 1: Enter wallet balance and choose tentative date setup flow:
  1. Card appears: "Setup Your Wallet" / "Allocate what you want to spend"
  2. Types ₹2000 into wallet balance box
  3. Tentative date options appear (25 Oct / 1 Nov / 17 Nov)
  4. Desktop cursor clicks to choose "25 Oct (7 Days)"
  5. Desktop cursor clicks "Save Balance"
  6. Card dissolves, and the Wallet Ring smoothly loads with:
     "This money is tentatively till 25 Oct" at the top!
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Container Frame -->
    <FrameLayout
        android:id="@+id/introWalletCanvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- ================= Beat 1: Setup Card ================= -->
        <LinearLayout
            android:id="@+id/introWalletSetupCard"
            android:layout_width="268dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_intro_feature_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Setup Your Wallet"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Allocate what you want to spend"
                android:textColor="?attr/textMutedColor"
                android:textSize="9sp" />

            <!-- Field 1: Amount Box -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Wallet balance"
                android:textColor="?attr/textMutedColor"
                android:textSize="8sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="4dp"
                android:background="?attr/inputBackground"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/introWalletInputField"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:includeFontPadding="false"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="₹2,000" />
            </FrameLayout>

            <!-- Field 2: Tentative Date Options -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:text="This budget is tentatively till"
                android:textColor="?attr/textMutedColor"
                android:textSize="8sp" />

            <LinearLayout
                android:id="@+id/introWalletDateOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <!-- Option 1: 25 Oct (7 Days) -->
                <LinearLayout
                    android:id="@+id/introWalletOption1"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_intro_chip"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/introWalletOption1Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="25 Oct"
                        android:textColor="?attr/textPrimaryColor"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/introWalletOption1Sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7 Days"
                        android:textColor="?attr/textMutedColor"
                        android:textSize="7sp" />
                </LinearLayout>

                <!-- Option 2: 1 Nov (14 Days) -->
                <LinearLayout
                    android:id="@+id/introWalletOption2"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_intro_chip"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/introWalletOption2Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 Nov"
                        android:textColor="?attr/textPrimaryColor"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/introWalletOption2Sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="14 Days"
                        android:textColor="?attr/textMutedColor"
                        android:textSize="7sp" />
                </LinearLayout>

                <!-- Option 3: 17 Nov (30 Days) -->
                <LinearLayout
                    android:id="@+id/introWalletOption3"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_intro_chip"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/introWalletOption3Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="17 Nov"
                        android:textColor="?attr/textPrimaryColor"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/introWalletOption3Sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30 Days"
                        android:textColor="?attr/textMutedColor"
                        android:textSize="7sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Save Button -->
            <TextView
                android:id="@+id/introWalletSaveBtn"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_intro_cta"
                android:gravity="center"
                android:text="Save Balance"
                android:textColor="?attr/primaryActionText"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ================= Beat 2: Wallet Ring Group ================= -->
        <LinearLayout
            android:id="@+id/introWalletRingGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:alpha="0">

            <!-- Top Tentative Date Text -->
            <TextView
                android:id="@+id/introWalletTentativeTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="12dp"
                android:letterSpacing="0.04"
                android:text="This money is tentatively till 25 Oct"
                android:textColor="?attr/textMutedColor"
                android:textSize="11sp" />

            <FrameLayout
                android:layout_width="210dp"
                android:layout_height="210dp"
                android:layout_gravity="center_horizontal">

                <com.cash.dash.IntroWalletRingView
                    android:id="@+id/introWalletRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/introWalletAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:includeFontPadding="false"
                        android:text="₹2,000"
                        android:textColor="?attr/textPrimaryColor"
                        android:textSize="@dimen/text_headline"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/introWalletLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/intro_wallet_label"
                        android:textColor="?attr/textMutedColor"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- ================= Desktop Cursor ================= -->
        <ImageView
            android:id="@+id/introWalletCursor"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:alpha="0"
            android:contentDescription="@null"
            android:src="@drawable/ic_desktop_cursor" />

    </FrameLayout>
</merge>
