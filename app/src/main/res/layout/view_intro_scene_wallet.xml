<?xml version="1.0" encoding="utf-8"?>
<!--
  Page 1: Enter wallet balance and choose tentative date via calendar popup:
  1. Card appears: "Setup Your Wallet" / "Allocate what you want to spend"
  2. Types ₹2000 into wallet balance box
  3. Cursor clicks the "Tentatively till" date field
  4. Mini Calendar popup opens with October 2026 grid
  5. Cursor clicks date "25" -> 25 gets circular highlight
  6. Calendar closes, date box updates to "25 Oct, 2026"
  7. Cursor clicks "Save Balance"
  8. Card dissolves, and Wallet Ring loads with "This money is tentatively till 25 Oct"!
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Container Frame -->
    <FrameLayout
        android:id="@+id/introWalletCanvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- ================= Beat 1: Setup Card ================= -->
        <LinearLayout
            android:id="@+id/introWalletSetupCard"
            android:layout_width="268dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_intro_feature_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Setup Your Wallet"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Allocate what you want to spend"
                android:textColor="?attr/textMutedColor"
                android:textSize="9sp" />

            <!-- Field 1: Amount Box -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Wallet balance"
                android:textColor="?attr/textMutedColor"
                android:textSize="8sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="4dp"
                android:background="?attr/inputBackground"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/introWalletInputField"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:includeFontPadding="false"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="₹2,000" />
            </FrameLayout>

            <!-- Field 2: Date Field Box (Clickable to open calendar) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:text="This budget is tentatively till"
                android:textColor="?attr/textMutedColor"
                android:textSize="8sp" />

            <LinearLayout
                android:id="@+id/introWalletDateFieldBox"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="4dp"
                android:background="?attr/inputBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_calendar_vector"
                    android:tint="?attr/textPrimaryColor" />

                <TextView
                    android:id="@+id/introWalletDateFieldText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="Select target date..."
                    android:textColor="?attr/textMutedColor"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Save Button -->
            <TextView
                android:id="@+id/introWalletSaveBtn"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_intro_cta"
                android:gravity="center"
                android:text="Save Balance"
                android:textColor="?attr/primaryActionText"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ================= Beat 2: Calendar Popup Modal ================= -->
        <LinearLayout
            android:id="@+id/introWalletCalendarModal"
            android:layout_width="230dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_intro_feature_card"
            android:elevation="14dp"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:alpha="0">

            <!-- Month Title Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="October 2026"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&lt;   &gt;"
                    android:textColor="?attr/textMutedColor"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Weekday Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="M" android:textColor="?attr/textMutedColor" android:textSize="8sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="T" android:textColor="?attr/textMutedColor" android:textSize="8sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="W" android:textColor="?attr/textMutedColor" android:textSize="8sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="T" android:textColor="?attr/textMutedColor" android:textSize="8sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="F" android:textColor="?attr/textMutedColor" android:textSize="8sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="S" android:textColor="?attr/textMutedColor" android:textSize="8sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="S" android:textColor="?attr/textMutedColor" android:textSize="8sp" />
            </LinearLayout>

            <!-- Dates Row 1 (12 - 18) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="12" android:textColor="?attr/textPrimaryColor" android:textSize="8sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="13" android:textColor="?attr/textPrimaryColor" android:textSize="8sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="14" android:textColor="?attr/textPrimaryColor" android:textSize="8sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="15" android:textColor="?attr/textPrimaryColor" android:textSize="8sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="16" android:textColor="?attr/textPrimaryColor" android:textSize="8sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="17" android:textColor="?attr/textPrimaryColor" android:textSize="8sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="18" android:textColor="?attr/textPrimaryColor" android:textSize="8sp" />
            </LinearLayout>

            <!-- Dates Row 2 (19 - 25) with target 25 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="19" android:textColor="?attr/textPrimaryColor" android:textSize="8sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="20" android:textColor="?attr/textPrimaryColor" android:textSize="8sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="21" android:textColor="?attr/textPrimaryColor" android:textSize="8sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="22" android:textColor="?attr/textPrimaryColor" android:textSize="8sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="23" android:textColor="?attr/textPrimaryColor" android:textSize="8sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="24" android:textColor="?attr/textPrimaryColor" android:textSize="8sp" />

                <!-- 25: Target Choice -->
                <FrameLayout
                    android:id="@+id/introWalletCalDay25"
                    android:layout_width="0dp"
                    android:layout_height="22dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/introWalletCalDay25Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="25"
                        android:textColor="?attr/textPrimaryColor"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>

            <!-- Dates Row 3 (26 - 31) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="26" android:textColor="?attr/textPrimaryColor" android:textSize="8sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="27" android:textColor="?attr/textPrimaryColor" android:textSize="8sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="28" android:textColor="?attr/textPrimaryColor" android:textSize="8sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="29" android:textColor="?attr/textPrimaryColor" android:textSize="8sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="30" android:textColor="?attr/textPrimaryColor" android:textSize="8sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="31" android:textColor="?attr/textPrimaryColor" android:textSize="8sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="1" android:textColor="?attr/textMutedColor" android:textSize="8sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================= Beat 3: Wallet Ring Group ================= -->
        <LinearLayout
            android:id="@+id/introWalletRingGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:alpha="0">

            <!-- Top Tentative Date Text -->
            <TextView
                android:id="@+id/introWalletTentativeTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="12dp"
                android:letterSpacing="0.04"
                android:text="This money is tentatively till 25 Oct"
                android:textColor="?attr/textMutedColor"
                android:textSize="11sp" />

            <FrameLayout
                android:layout_width="210dp"
                android:layout_height="210dp"
                android:layout_gravity="center_horizontal">

                <com.cash.dash.IntroWalletRingView
                    android:id="@+id/introWalletRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/introWalletAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:includeFontPadding="false"
                        android:text="₹2,000"
                        android:textColor="?attr/textPrimaryColor"
                        android:textSize="@dimen/text_headline"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/introWalletLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/intro_wallet_label"
                        android:textColor="?attr/textMutedColor"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- ================= Desktop Cursor ================= -->
        <ImageView
            android:id="@+id/introWalletCursor"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:elevation="30dp"
            android:translationZ="30dp"
            android:alpha="0"
            android:contentDescription="@null"
            android:src="@drawable/ic_desktop_cursor" />

    </FrameLayout>
</merge>
