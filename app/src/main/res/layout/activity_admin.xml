<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="?attr/mainBackground">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="?attr/roundBackground"
            android:src="@drawable/ic_back_arrow1"
            app:tint="?attr/textPrimaryColor"
            android:padding="10dp"
            android:scaleType="fitCenter"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Admin Center"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="20dp"/>

        <ImageButton
            android:id="@+id/btnHistory"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="?attr/roundBackground"
            android:src="@drawable/ic_history_solid"
            app:tint="?attr/textPrimaryColor"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:layout_gravity="center_vertical"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="25dp"
            android:paddingEnd="25dp"
            android:paddingBottom="25dp"
            android:paddingTop="5dp">


            <TextView
                android:id="@+id/btnGoToAnnouncements"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:text="Announcements"
                android:gravity="center"
                android:textColor="?attr/textPrimaryColor"
                android:background="?attr/roundBackground"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/btnGoToPushNotifications"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:text="Push Notifications"
                android:gravity="center"
                android:textColor="?attr/textPrimaryColor"
                android:background="?attr/roundBackground"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/btnGoToPromotions"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:text="Promotions"
                android:gravity="center"
                android:textColor="?attr/textPrimaryColor"
                android:background="?attr/roundBackground"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="30dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Last Seen Status of Users"
                android:textSize="@dimen/text_title"
                android:textColor="?attr/textPrimaryColor"
                android:textStyle="bold"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Check which users were active (opened the app) on a specific date."
                android:textSize="@dimen/text_body"
                android:textColor="?attr/textMutedColor"
                android:layout_marginBottom="20dp"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnSelectDate"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Date: Today"
                android:textColor="?attr/textPrimaryColor"
                android:background="?attr/roundBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="20dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>

            <LinearLayout
                android:id="@+id/layoutUserStatusContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="?attr/inputBackground"
                android:layout_marginBottom="16dp"/>



            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border"
                android:layout_marginBottom="24dp"/>

            <!-- Admin Access Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="🛡️ Admin Access"
                    android:textSize="@dimen/text_title"
                    android:textColor="?attr/textPrimaryColor"
                    android:textStyle="bold"/>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manage admin roles and permissions."
                android:textSize="@dimen/text_body"
                android:textColor="?attr/textMutedColor"
                android:layout_marginBottom="16dp"/>



            <!-- Admins Container -->
            <LinearLayout
                android:id="@+id/layoutAdminAccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <LinearLayout
                android:id="@+id/btnAddAdminSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="21dp"
                android:paddingBottom="21dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_plus_vector"
                    app:tint="?attr/textPrimaryColor" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add Admin"
                    android:textSize="15sp"
                    android:textColor="?attr/textPrimaryColor"
                    android:layout_marginStart="8dp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutSearchWrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etSearchNewAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Search user by name or email"
                    android:textColor="?attr/textPrimaryColor"
                    android:textColorHint="?attr/textMutedColor"
                    android:background="?attr/inputBackground"
                    android:paddingHorizontal="16dp"
                    android:inputType="textEmailAddress"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/layoutAdminSearchResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/dividerColor"
                android:layout_marginBottom="24dp"/>

            <!-- Support Inbox Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📬 Support Inbox"
                android:textSize="@dimen/text_title"
                android:textColor="?attr/textPrimaryColor"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Unreplied user queries. Tap a link to open the admin reply page."
                android:textSize="@dimen/text_body"
                android:textColor="?attr/textMutedColor"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvInboxEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="@dimen/text_body"
                android:textColor="?attr/textMutedColor"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="16dp"
                android:visibility="visible"/>

            <LinearLayout
                android:id="@+id/layoutSupportInbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnResolveAll"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Auto Resolve All"
                android:textColor="@android:color/white"
                android:backgroundTint="#FF4D4D"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="40dp"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
