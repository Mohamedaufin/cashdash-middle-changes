<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mainBackground">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="?attr/roundBackground"
            android:src="@drawable/ic_back_arrow1"
            app:tint="?attr/textPrimaryColor"
            android:padding="10dp"
            android:scaleType="fitCenter"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Admin Center"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="20dp"/>

        <ImageButton
            android:id="@+id/btnHistory"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="?attr/roundBackground"
            android:src="@drawable/ic_history_solid"
            app:tint="?attr/textPrimaryColor"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:layout_gravity="center_vertical"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="25dp"
            android:paddingEnd="25dp"
            android:paddingBottom="25dp"
            android:paddingTop="5dp">


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Announcements"
                android:textSize="@dimen/text_title"
                android:textColor="?attr/textPrimaryColor"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Publishing an announcement here will immediately push it to all users' Notification feeds."
                android:textSize="@dimen/text_body"
                android:textColor="?attr/textMutedColor"
                android:layout_marginBottom="25dp"/>


            <EditText
                android:id="@+id/edtAnnouncementTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/inputBackground"
                android:padding="15dp"
                android:hint="Announcement Title"
                android:textColorHint="?attr/textMutedColor"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="@dimen/text_body"
                android:layout_marginBottom="15dp"
                android:inputType="textCapSentences"
                android:singleLine="true"/>

            <EditText
                android:id="@+id/edtAnnouncementBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/inputBackground"
                android:padding="15dp"
                android:hint="Write your announcement content here..."
                android:textColorHint="?attr/textMutedColor"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="@dimen/text_body"
                android:layout_marginBottom="25dp"
                android:gravity="top|start"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="5"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/btnPublishGlobalAnnouncement"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_weight="1"
                    android:text="Send Globally"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#008000"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginEnd="10dp"/>

                <Button
                    android:id="@+id/btnPublishAdminAnnouncement"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_weight="1"
                    android:text="Send to Admin"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#FF4D4D"
                    android:textStyle="bold"
                    android:textSize="14sp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnPublishUserAnnouncement"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Send User Specific Announcements"
                android:textColor="@android:color/white"
                android:backgroundTint="#FFA500"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="40dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Push Notifications"
                android:textSize="@dimen/text_title"
                android:textColor="?attr/textPrimaryColor"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sending a push notification will instantly ring all users' devices with a custom popup alert."
                android:textSize="@dimen/text_body"
                android:textColor="?attr/textMutedColor"
                android:layout_marginBottom="25dp"/>

            <EditText
                android:id="@+id/edtPushTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/inputBackground"
                android:padding="15dp"
                android:hint="Push Title (e.g. Server Update)"
                android:textColorHint="?attr/textMutedColor"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="@dimen/text_body"
                android:layout_marginBottom="15dp"
                android:inputType="textCapSentences"
                android:singleLine="true"/>

            <EditText
                android:id="@+id/edtPushBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/inputBackground"
                android:padding="15dp"
                android:hint="Push Message body..."
                android:textColorHint="?attr/textMutedColor"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="@dimen/text_body"
                android:layout_marginBottom="25dp"
                android:gravity="top|start"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="3"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btnSendGlobalPush"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_weight="1"
                    android:text="Send Globally"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#008000"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginEnd="10dp"/>

                <Button
                    android:id="@+id/btnSendAdminPush"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_weight="1"
                    android:text="Send to Admin"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#FF4D4D"
                    android:textStyle="bold"
                    android:textSize="14sp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnSendUserPush"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Send User Specific Notifications"
                android:textColor="@android:color/white"
                android:backgroundTint="#FFA500"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="25dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Last Seen Status of Users"
                android:textSize="@dimen/text_title"
                android:textColor="?attr/textPrimaryColor"
                android:textStyle="bold"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Check which users were active (opened the app) on a specific date."
                android:textSize="@dimen/text_body"
                android:textColor="?attr/textMutedColor"
                android:layout_marginBottom="20dp"/>

            <Button
                android:id="@+id/btnSelectDate"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Date: Today"
                android:textColor="@android:color/white"
                android:background="?attr/roundBackground"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="20dp"
                android:drawableStart="@android:drawable/ic_menu_my_calendar"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>

            <LinearLayout
                android:id="@+id/layoutUserStatusContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="?attr/inputBackground"
                android:layout_marginBottom="40dp"/>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border"
                android:layout_marginBottom="36dp"/>

            <!-- Support Inbox Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📬 Support Inbox"
                android:textSize="@dimen/text_title"
                android:textColor="?attr/textPrimaryColor"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Unreplied user queries. Tap a link to open the admin reply page."
                android:textSize="@dimen/text_body"
                android:textColor="?attr/textMutedColor"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvInboxEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="@dimen/text_body"
                android:textColor="?attr/textMutedColor"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="16dp"
                android:visibility="visible"/>

            <LinearLayout
                android:id="@+id/layoutSupportInbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnResolveAll"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Auto Resolve All"
                android:textColor="@android:color/white"
                android:backgroundTint="#FF4D4D"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="40dp"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
