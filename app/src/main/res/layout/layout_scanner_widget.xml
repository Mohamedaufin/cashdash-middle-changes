<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Square Container (One UI style) centered to prevent stretching -->
    <FrameLayout
        android:id="@+id/widgetContainer"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_widget_squircle_white"
        android:padding="12dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:src="@drawable/ic_scanner_brackets"
            android:scaleType="fitCenter"
            android:contentDescription="Scan QR" />

        <!-- App Logo Badge (bottom-right corner) -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="bottom|end"
            android:src="@drawable/ic_logo_shield"
            android:contentDescription="CashDash Logo" />

    </FrameLayout>

</FrameLayout>



