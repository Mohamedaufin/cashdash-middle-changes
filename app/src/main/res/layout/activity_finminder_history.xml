<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mainBackground"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/roundBackground"
            android:padding="12dp"
            android:src="@drawable/ic_back_arrow1"
            app:tint="?attr/textPrimaryColor"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:text="History"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Details Box -->
    <LinearLayout
        android:id="@+id/layoutDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/transactionBackground"
        android:padding="20dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/topBar">
        
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="120dp" android:layout_height="wrap_content" android:text="Title:" android:textColor="?attr/textMutedColor" android:textSize="16dp"/>
            <TextView android:id="@+id/tvTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Milk" android:textColor="?attr/textPrimaryColor" android:textSize="16dp" android:textStyle="bold"/>
        </LinearLayout>
        
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
            <TextView android:layout_width="120dp" android:layout_height="wrap_content" android:text="Frequency:" android:textColor="?attr/textMutedColor" android:textSize="16dp"/>
            <TextView android:id="@+id/tvFrequency" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Weekly" android:textColor="?attr/textPrimaryColor" android:textSize="16dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
            <TextView android:layout_width="120dp" android:layout_height="wrap_content" android:text="Type:" android:textColor="?attr/textMutedColor" android:textSize="16dp"/>
            <TextView android:id="@+id/tvType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cashout" android:textColor="?attr/textPrimaryColor" android:textSize="16dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
            <TextView android:layout_width="120dp" android:layout_height="wrap_content" android:text="Amount:" android:textColor="?attr/textMutedColor" android:textSize="16dp"/>
            <TextView android:id="@+id/tvAmount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100 Rs" android:textColor="?attr/textPrimaryColor" android:textSize="16dp" android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Table Header -->
    <LinearLayout
        android:id="@+id/layoutTableHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="25dp"
        android:layout_marginTop="20dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/layoutDetails">
        
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1.5"
            android:layout_height="wrap_content"
            android:text="S.No"
            android:textColor="?attr/textMutedColor"
            android:textStyle="bold"
            android:textSize="14dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="3.5"
            android:layout_height="wrap_content"
            android:text="Date"
            android:textColor="?attr/textMutedColor"
            android:textStyle="bold"
            android:textSize="14dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="5"
            android:layout_height="wrap_content"
            android:text="Status"
            android:gravity="end"
            android:textColor="?attr/textMutedColor"
            android:textStyle="bold"
            android:textSize="14dp"/>
    </LinearLayout>
    
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginHorizontal="25dp"
        app:layout_constraintTop_toBottomOf="@id/layoutTableHeader"/>

    <!-- RecyclerView for History -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="40dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="25dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
