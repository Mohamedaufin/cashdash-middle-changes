<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootNotificationLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/mainBackground"
    android:fitsSystemWindows="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        android:layout_marginBottom="4dp">


        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:text="Notifications"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnDeleteCategory"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_trash"
            android:padding="10dp"
            app:tint="?attr/textPrimaryColor"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvHeader"
            app:layout_constraintBottom_toBottomOf="@id/tvHeader" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Filter Bar - visibility controlled in Kotlin -->
    <LinearLayout
        android:id="@+id/filterBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/chipAll"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="All"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            android:background="?attr/inputBackground"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/chipResponded"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Responded"
            android:textColor="#A0A0A0"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            android:background="?attr/inputBackground"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/chipPending"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Pending"
            android:textColor="#A0A0A0"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            android:background="?attr/inputBackground"/>
    </LinearLayout>

    <!-- Search Bar -->
    <LinearLayout
        android:id="@+id/searchBarContainer"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:layout_marginBottom="12dp"
        android:background="?attr/inputBackground"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:addStatesFromChildren="true"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btnExitSearch"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_search_back"
            app:tint="@color/text_secondary"
            android:scaleType="fitCenter"/>

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@null"
            android:hint="Search notifications..."
            android:textColorHint="?attr/textMutedColor"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="14sp"
            android:inputType="text"
            android:maxLines="1"
            android:imeOptions="actionSearch"/>

        <LinearLayout
            android:id="@+id/searchControls"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSearchCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/0"
                android:textColor="?attr/textSecondaryColor"
                android:textSize="12sp"
                android:layout_marginEnd="8dp"/>

            <ImageButton
                android:id="@+id/btnSearchPrev"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_search_up"
                app:tint="@color/text_secondary"
                android:scaleType="fitCenter"/>

            <ImageButton
                android:id="@+id/btnSearchNext"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_search_down"
                app:tint="@color/text_secondary"
                android:layout_marginStart="8dp"
                android:scaleType="fitCenter"/>
        </LinearLayout>
    </LinearLayout>



    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNotifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:paddingStart="25dp"
            android:paddingEnd="25dp"
            android:paddingTop="4dp"
            android:isScrollContainer="true"
            android:scrollbarStyle="outsideOverlay" />

        <TextView
            android:id="@+id/tvEmptyNotifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="40dp"
            android:text="No notifications yet.\n\nWe'll notify you when your support\nqueries are resolved!"
            android:textColor="?attr/textMutedColor"
            android:textSize="@dimen/text_subhead"
            android:visibility="gone"/>

    </FrameLayout>
</LinearLayout>
