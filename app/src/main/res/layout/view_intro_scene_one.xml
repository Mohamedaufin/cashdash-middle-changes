<?xml version="1.0" encoding="utf-8"?>
<!--
  Intro scene one: the archway.

  Everything is positioned with percentage widths and constraint bias rather than margins, so
  the composition holds its proportions from a small phone to a tablet instead of drifting
  into a corner.

  The four steps and the brand arc are pinned to the archway's own bounds rather than to the
  scene. They share its 130x150 drawable box, so pinning them means fitCenter maps all six
  drawables through the identical transform and they line up exactly, at any size, with no
  offsets to keep in step by hand.

  Declaration order is z-order: the chevron comes after the archway because it overlaps it.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sceneOne"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/introOneArch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_intro_arch"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.52"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.40"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.56" />

    <ImageView
        android:id="@+id/introOneStep1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_intro_step_1"
        app:layout_constraintBottom_toBottomOf="@id/introOneArch"
        app:layout_constraintEnd_toEndOf="@id/introOneArch"
        app:layout_constraintStart_toStartOf="@id/introOneArch"
        app:layout_constraintTop_toTopOf="@id/introOneArch" />

    <ImageView
        android:id="@+id/introOneStep2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_intro_step_2"
        app:layout_constraintBottom_toBottomOf="@id/introOneArch"
        app:layout_constraintEnd_toEndOf="@id/introOneArch"
        app:layout_constraintStart_toStartOf="@id/introOneArch"
        app:layout_constraintTop_toTopOf="@id/introOneArch" />

    <ImageView
        android:id="@+id/introOneStep3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_intro_step_3"
        app:layout_constraintBottom_toBottomOf="@id/introOneArch"
        app:layout_constraintEnd_toEndOf="@id/introOneArch"
        app:layout_constraintStart_toStartOf="@id/introOneArch"
        app:layout_constraintTop_toTopOf="@id/introOneArch" />

    <ImageView
        android:id="@+id/introOneStep4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_intro_step_4"
        app:layout_constraintBottom_toBottomOf="@id/introOneArch"
        app:layout_constraintEnd_toEndOf="@id/introOneArch"
        app:layout_constraintStart_toStartOf="@id/introOneArch"
        app:layout_constraintTop_toTopOf="@id/introOneArch" />

    <!-- Centre and radius describe the archway's own top arc: (63,60) r49 in a 130x150 box,
         pulled in to 0.30 so the lettering sits inside the frame rather than on it. -->
    <com.cash.dash.ArcTextView
        android:id="@+id/introOneBrand"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:arcCenterX="0.4846"
        app:arcCenterY="0.40"
        app:arcLetterSpacing="0.12"
        app:arcRadius="0.30"
        app:arcSweep="120"
        app:arcText="@string/intro_brand_arc"
        app:arcTextColor="@color/intro_pink"
        app:arcTextSize="16sp"
        app:layout_constraintBottom_toBottomOf="@id/introOneArch"
        app:layout_constraintEnd_toEndOf="@id/introOneArch"
        app:layout_constraintStart_toStartOf="@id/introOneArch"
        app:layout_constraintTop_toTopOf="@id/introOneArch" />

    <ImageView
        android:id="@+id/introOneChevron"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_intro_chevron"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.04"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.50"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.27" />

    <ImageView
        android:id="@+id/introOneWallet"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_intro_wallet"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.22"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.06"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.16" />

    <ImageView
        android:id="@+id/introOneCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_intro_card"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.78"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.04"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.15" />

    <ImageView
        android:id="@+id/introOneCoin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_intro_coin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.03"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.18"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.14" />

    <ImageView
        android:id="@+id/introOneTag"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_intro_tag"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.95"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.36"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.14" />
</androidx.constraintlayout.widget.ConstraintLayout>
