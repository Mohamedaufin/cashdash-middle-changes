<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <!-- Menu button -->
    <ImageView
        android:id="@+id/btnMenu"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="64dp"
        android:src="@drawable/ic_glass_menu_vector"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <!-- Greeting -->
    <LinearLayout
        android:id="@+id/layoutHomeGreeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="14dp"
        android:gravity="center_vertical"
        app:layout_constraintStart_toEndOf="@id/btnMenu"
        app:layout_constraintTop_toTopOf="@id/btnMenu"
        app:layout_constraintBottom_toBottomOf="@id/btnMenu">
        <TextView
            android:id="@+id/tvHello"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hello "
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvUsernameHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:transitionName="greeting_text_transition" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=","
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />
    </LinearLayout>
    <!-- Profile button -->
    <ImageView
        android:id="@+id/btnProfile"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:padding="4dp"
        android:src="@drawable/ic_profile"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnMenu"
        app:layout_constraintBottom_toBottomOf="@id/btnMenu"/>
    <TextView
        android:id="@+id/tvNextMoney"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Next money in 0 days"
        android:textColor="?attr/textMutedColor"
        android:textSize="@dimen/text_subhead"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@id/walletContainer"
        android:layout_marginBottom="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <!-- WALLET CIRCLE -->
    <FrameLayout
        android:id="@+id/walletContainer"
        android:layout_width="340dp"
        android:layout_height="340dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toBottomOf="@id/layoutHomeGreeting"
        app:layout_constraintBottom_toTopOf="@id/cardScanner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="65dp"
        android:layout_marginBottom="40dp">

        <com.cash.dash.GradientCircularProgressView
            android:id="@+id/walletProgress"
            android:layout_width="340dp"
            android:layout_height="340dp"

            android:layout_gravity="center" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="7dp"
                android:text="₹5000"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="@dimen/text_headline"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wallet balance"
                android:textStyle="bold"
                android:textColor="?attr/textMutedColor"
                android:textSize="@dimen/text_body"/>
        </LinearLayout>
    </FrameLayout>
    <!-- ACTION CARDS -->
    <LinearLayout
        android:id="@+id/cardScanner"
        android:layout_width="120dp"
        android:layout_height="110dp"
        android:layout_marginTop="35dp"
        android:layout_marginStart="32dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/cardBackground"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/walletContainer"

        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/iconScanner"
            android:layout_width="40dp"
            android:layout_height="65dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_scanner" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Scanner"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/cardRigor"
        android:layout_width="120dp"
        android:layout_height="110dp"
        android:layout_marginTop="35dp"
        android:layout_marginEnd="32dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/cardBackground"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/walletContainer"

        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:id="@+id/iconRigorTracker"
            android:layout_width="85dp"
            android:layout_height="65dp"
            android:src="@drawable/ic_rigor_tracker"
            android:scaleType="fitCenter"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Rigor Tracker"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>