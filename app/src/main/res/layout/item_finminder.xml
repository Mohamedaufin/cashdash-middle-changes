<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?attr/transactionBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvQuantData"
            app:layout_constraintTop_toTopOf="parent"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/text_subhead"
            android:textStyle="bold"
            android:text="Milk" />

        <!-- Quantity Data -->
        <TextView
            android:id="@+id/tvQuantData"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/tvTitle"
            app:layout_constraintEnd_toStartOf="@id/tvDateInfo"
            app:layout_constraintTop_toTopOf="@id/tvTitle"
            app:layout_constraintBottom_toBottomOf="@id/tvTitle"
            android:gravity="center"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/text_body"
            android:text="1000" />

        <!-- Date Info -->
        <TextView
            android:id="@+id/tvDateInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/tvQuantData"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvTitle"
            app:layout_constraintBottom_toBottomOf="@id/tvTitle"
            android:gravity="center"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/text_body"
            android:text="15/06" />

        <!-- Frequency Info -->
        <TextView
            android:id="@+id/tvFrequencyInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/tvDateInfo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvDateInfo"
            app:layout_constraintEnd_toEndOf="@id/tvDateInfo"
            android:textColor="?attr/textMutedColor"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:text="(one time)" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/layoutExtendedInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvExtendedInfo1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/textMutedColor"
            android:textSize="13sp"
            android:text="• Weekly cash out set at every Monday" />

        <TextView
            android:id="@+id/tvExtendedInfo2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/textMutedColor"
            android:textSize="13sp"
            android:text="• Next target dates are 18/06/2026 and 25/06/2026" />
            
    </LinearLayout>
</LinearLayout>
