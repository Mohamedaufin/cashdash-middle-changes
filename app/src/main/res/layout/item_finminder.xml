<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="?attr/transactionBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:gravity="center_vertical">

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="?attr/textPrimaryColor"
        android:textSize="@dimen/text_subhead"
        android:textStyle="bold"
        android:text="Milk" />

    <!-- Quantity Data -->
    <TextView
        android:id="@+id/tvQuantData"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="?attr/textPrimaryColor"
        android:textSize="@dimen/text_body"
        android:text="1000" />

    <!-- Date/Frequency Info -->
    <TextView
        android:id="@+id/tvDateInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="?attr/textPrimaryColor"
        android:textSize="@dimen/text_body"
        android:text="15/06" />

    <!-- Checkbox / Repeat Icon Container -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center">
        <CheckBox
            android:id="@+id/cbFinminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:buttonTint="?attr/textPrimaryColor"
            android:scaleX="1.2"
            android:scaleY="1.2"/>
            
        <ImageView
            android:id="@+id/ivRepeatIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_repeat"
            app:tint="?attr/textPrimaryColor"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
