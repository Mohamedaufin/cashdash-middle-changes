<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="28dp"
    android:paddingEnd="28dp"
    android:paddingBottom="24dp"
    android:background="?attr/transactionItemBackground">

    <TextView
        android:id="@+id/tvConfirmTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Are you sure?"
        android:textColor="?attr/textPrimaryColor"
        android:textSize="@dimen/text_title"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="20dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvConfirmMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This action cannot be undone."
                android:textColor="?attr/textPrimaryColor"
                android:textSize="@dimen/text_body"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvTargetUsers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/textMutedColor"
                android:textSize="13sp"
                android:gravity="center"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConfirmCancel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="54dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            android:background="?attr/cardBackground"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:layout_marginEnd="8dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConfirmAction"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="54dp"
            android:text="Confirm"
            android:textAllCaps="false"
            android:textColor="?attr/textRedColor"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            android:background="?attr/cardBackground"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>
