<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mainBackground">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="50dp"
        android:paddingBottom="20dp"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="?attr/roundBackground"
            android:src="@drawable/ic_back_arrow1"
            app:tint="?attr/textPrimaryColor"
            android:padding="10dp"
            android:layout_gravity="center_vertical"
            android:scaleType="fitCenter"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Help Center"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="20dp"/>

        <RelativeLayout
            android:id="@+id/btnNotifications"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/borderedRoundBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerInParent="true"
                android:src="@drawable/ic_bell"
                app:tint="?attr/textPrimaryColor"/>

            <View
                android:id="@+id/notificationBadge"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:background="?attr/glass3dRedBackground"
                android:visibility="gone"/>
        </RelativeLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- GENERAL START -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="General FAQs"
                android:textColor="?attr/textMutedColor"
                android:textSize="@dimen/text_subhead"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?attr/cardBackground"
                android:padding="15dp"
                android:layout_marginBottom="25dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Q: What exactly does CashDash do?"
                    android:textColor="?attr/textPrimaryColor"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_body"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A: CashDash helps you visualize how fast you run out of money in your current lifestyle. You scan QR codes to pay, and the app instantly logs it to deduct your 'Wallet' and tracks it in 'History'."
                    android:textColor="?attr/textMutedColor"
                    android:textSize="@dimen/text_body"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Q: Do I need an internet connection to use the app?"
                    android:textColor="?attr/textPrimaryColor"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_body"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A: To use the automatic QR scanner smoothly, yes. However, you can use the 'Rigor Tracker' to log manual expenses completely offline, and they'll sync to the cloud later."
                    android:textColor="?attr/textMutedColor"
                    android:textSize="@dimen/text_body"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Q: Is my financial data secure?"
                    android:textColor="?attr/textPrimaryColor"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_body"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A: Yes! Your data is privately locked to your account using Firebase Authentication. There is no bank-linking or raw transaction scraping."
                    android:textColor="?attr/textMutedColor"
                    android:textSize="@dimen/text_body"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Q: If I get a new phone or reinstall, do I lose my data?"
                    android:textColor="?attr/textPrimaryColor"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_body"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A: No! Everything is backed up to the cloud. Just log back in with the exact account and all data will reappear instantly."
                    android:textColor="?attr/textMutedColor"
                    android:textSize="@dimen/text_body"/>
            </LinearLayout>

            <!-- HOME START -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home Dashboard"
                android:textColor="?attr/textMutedColor"
                android:textSize="@dimen/text_subhead"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?attr/cardBackground"
                android:padding="15dp"
                android:layout_marginBottom="25dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Q: How do I use the QR Scanner (Tutorial)?"
                    android:textColor="?attr/textPrimaryColor"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_body"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A: Scan from CashDash directly and record your payments:\n1. Scan any UPI QR code\n2. Enter the amount and select an allocation\n3. Choose your payment app (Cred, GPay)\n4. Complete the payment in your UPI app and wait for 2-3 seconds\n5. We will automatically bring you back to CashDash and record the transaction\n\nGeneral shortcuts:\n1. Tap Undo button to pay again to the last scanned receiver\n2. Swipe right to left to go home page or use exit button at top"
                    android:textColor="?attr/textMutedColor"
                    android:textSize="@dimen/text_body"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Q: How do I use the Rigor Tracker (Tutorial)?"
                    android:textColor="?attr/textPrimaryColor"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_body"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A: This helps to manually record your expenses:\n1. Enter expense title and amount\n2. Choose date of expense from calendar\n3. Tap Next and choose an allocation\n4. Thats it, Your expense has been recorded manually and wallet has been deducted"
                    android:textColor="?attr/textMutedColor"
                    android:textSize="@dimen/text_body"
                    android:layout_marginBottom="12dp"/>


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Q: What is the big Wallet Circle for?"
                    android:textColor="?attr/textPrimaryColor"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_body"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A: It's your fuel gauge. It shows how much money you have left vs what you started with. If it's completely empty, you have spent your planned budget!"
                    android:textColor="?attr/textMutedColor"
                    android:textSize="@dimen/text_body"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Q: How do I scan and pay?"
                    android:textColor="?attr/textPrimaryColor"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_body"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A: Tap the QR icon at the bottom of the home screen. After capturing a QR, enter the amount, and CashDash will transfer you to Cred UPI to finish the payment. The amount is auto-logged!"
                    android:textColor="?attr/textMutedColor"
                    android:textSize="@dimen/text_body"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Q: What is the Rigor Tracker (Search Icon)?"
                    android:textColor="?attr/textPrimaryColor"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_body"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A: The Rigor Tracker allows you to manually add expenses that weren't paid via QR scanning (like handing over physical cash, or an online subscription)."
                    android:textColor="?attr/textMutedColor"
                    android:textSize="@dimen/text_body"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Q: How do I delete a mistake transaction?"
                    android:textColor="?attr/textPrimaryColor"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_body"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="A: "
                        android:textColor="?attr/textMutedColor"
                        android:textSize="@dimen/text_body" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Step 1: Open History."
                        android:textColor="?attr/textMutedColor"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="     "
                        android:textColor="?attr/textMutedColor"
                        android:textSize="@dimen/text_body" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Step 2: At the top-left, tap the 'Daily/Weekly/Monthly' button, change it to Daily, then click the relevant date on the graph."
                        android:textColor="?attr/textMutedColor"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="     "
                        android:textColor="?attr/textMutedColor"
                        android:textSize="@dimen/text_body" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Step 3: Click and hold the specific transaction for menu options."
                        android:textColor="?attr/textMutedColor"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Q: Can I delete an old transaction from last week?"
                    android:textColor="?attr/textPrimaryColor"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_body"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A: Yes, you can delete any transaction by pressing and holding the transaction."
                    android:textColor="?attr/textMutedColor"
                    android:textSize="@dimen/text_body"/>
            </LinearLayout>

            <!-- ALLOCATOR START -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Allocator (Categories)"
                android:textColor="?attr/textMutedColor"
                android:textSize="@dimen/text_subhead"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?attr/cardBackground"
                android:padding="15dp"
                android:layout_marginBottom="25dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Q: How do I use the Category Allocator (Tutorial)?"
                    android:textColor="?attr/textPrimaryColor"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_body"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A: Here, you can set new allocations (Shopping, Food, etc.) and set limits for the category:\n1. Tap '+ Add New' to create a new category\n2. Press done and set an optional spending limit for it\n\nGeneral shortcuts:\n1. Swipe right to left to delete an allocation\n2. Press and hold allocation to rename it\n3. Tap on allocation to view insights of its spending trend"
                    android:textColor="?attr/textMutedColor"
                    android:textSize="@dimen/text_body"
                    android:layout_marginBottom="12dp"/>


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Q: How do I set a sub-budget?"
                    android:textColor="?attr/textPrimaryColor"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_body"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A: Add a category (like 'Food'). Then click the 'Set Limit' button on the allocation card."
                    android:textColor="?attr/textMutedColor"
                    android:textSize="@dimen/text_body"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Q: My allocation spent bar turned red, what does it mean?"
                    android:textColor="?attr/textPrimaryColor"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_body"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A: It means you have spent more than the limit you set for this specific allocation."
                    android:textColor="?attr/textMutedColor"
                    android:textSize="@dimen/text_body"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Q: How do I delete or rename a category?"
                    android:textColor="?attr/textPrimaryColor"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_body"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="A: "
                        android:textColor="?attr/textMutedColor"
                        android:textSize="@dimen/text_body" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="To Delete: Swipe the allocation card right-to-left off the screen."
                        android:textColor="?attr/textMutedColor"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="     "
                        android:textColor="?attr/textMutedColor"
                        android:textSize="@dimen/text_body" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="To Rename: Press and hold the allocation card for a second."
                        android:textColor="?attr/textMutedColor"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Q: What is the 'Overall' category in history?"
                    android:textColor="?attr/textPrimaryColor"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_body"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A: Overall is a master category that tracks the sum of all the allocation expenses combined."
                    android:textColor="?attr/textMutedColor"
                    android:textSize="@dimen/text_body"/>
            </LinearLayout>

            <!-- HISTORY START -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="History &amp; Graphing"
                android:textColor="?attr/textMutedColor"
                android:textSize="@dimen/text_subhead"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?attr/cardBackground"
                android:padding="15dp"
                android:layout_marginBottom="25dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Q: How do I use the History page (Tutorial)?"
                    android:textColor="?attr/textPrimaryColor"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_body"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A: View all your recorded transactions:\n1. Use the search bar to find specific expenses quickly\n2. Tap daily button to switch over weekly/monthly graphs\n3. Tap overall to change allocation and view specific category's expense"
                    android:textColor="?attr/textMutedColor"
                    android:textSize="@dimen/text_body"
                    android:layout_marginBottom="12dp"/>


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Q: How do I see a breakdown of a specific day?"
                    android:textColor="?attr/textPrimaryColor"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_body"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A: Tap on a graph! It will open a detailed screen showing every individual transaction made that day"
                    android:textColor="?attr/textMutedColor"
                    android:textSize="@dimen/text_body"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Q: Can I see a graph for only 'Travel'?"
                    android:textColor="?attr/textPrimaryColor"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_body"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A: Yes! Look for the 'Overall' button at the top right of the history screen. Tap it to filter the graph to a specific allocation."
                    android:textColor="?attr/textMutedColor"
                    android:textSize="@dimen/text_body"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Q: How do I jump back to an old month expense?"
                    android:textColor="?attr/textPrimaryColor"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_body"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A: Tap the 'Monthly' button in history."
                    android:textColor="?attr/textMutedColor"
                    android:textSize="@dimen/text_body"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Q: My graph is completely empty, is my data lost?"
                    android:textColor="?attr/textPrimaryColor"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_body"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A: No! You are likely viewing a month/week where you didn't log anything, or you have a specific category filter applied at the top right (like 'Food') that has no expenses for that period. Switch the top-right filter back to 'Overall' to see all data."
                    android:textColor="?attr/textMutedColor"
                    android:textSize="@dimen/text_body"/>
            </LinearLayout>

            <!-- MENU START -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menu &amp; Profile"
                android:textColor="?attr/textMutedColor"
                android:textSize="@dimen/text_subhead"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?attr/cardBackground"
                android:padding="15dp"
                android:layout_marginBottom="40dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Q: What does 'Money Schedule' do?"
                    android:textColor="?attr/textPrimaryColor"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_body"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A: Use this to set your 'Payday' or Allowance frequency (e.g., every 30 days). When that day arrives, CashDash will automatically 'Roll Over' by resetting your Wallet to full and clearing your allocation spent amounts for the new cycle!"
                    android:textColor="?attr/textMutedColor"
                    android:textSize="@dimen/text_body"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Q: How do I change my budget?"
                    android:textColor="?attr/textPrimaryColor"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_body"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A: Go to the Menu and tap 'Balance Bar'. This lets you add more cash or reset your existing amount over new amount."
                    android:textColor="?attr/textMutedColor"
                    android:textSize="@dimen/text_body"
                    android:layout_marginBottom="12dp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Q: Where do I see support replies?"
                    android:textColor="?attr/textPrimaryColor"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_body"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A: You'll receive a Push Notification when we reply. Alternatively, tap the Bell icon in the Menu to view your full support history."
                    android:textColor="?attr/textMutedColor"
                    android:textSize="@dimen/text_body"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Q: How do I reset my budget cycle right now?"
                    android:textColor="?attr/textPrimaryColor"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_body"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A: Go to 'Money Schedule' in the Menu and tap the 'Reset Cycle Now' button at the bottom. This will instantly replenish your wallet and clear your allocation spent amounts."
                    android:textColor="?attr/textMutedColor"
                    android:textSize="@dimen/text_body"/>
            </LinearLayout>

            <!-- CONTACT US PROMPT -->
            <TextView
                android:id="@+id/btnContactUs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Still stuck? Contact Support"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="@dimen/text_subhead"
                android:gravity="center"
                android:padding="20dp"
                android:background="?attr/cardBackground"
                android:layout_marginBottom="30dp"
                android:textStyle="bold"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
