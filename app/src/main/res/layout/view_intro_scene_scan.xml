<?xml version="1.0" encoding="utf-8"?>
<!--
  Page 2: the full payment story â€” scan, find, enter, allocate, pay.

  Everything is housed inside a mock "phone frame" container that is 160dp x 286dp,
  giving it a realistic 16:9 phone aspect ratio. The UI is scaled down proportionately.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Container for the phone -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- The Phone Frame -->
        <FrameLayout
            android:id="@+id/introScanPhone"
            android:layout_width="190dp"
            android:layout_height="340dp"
            android:background="@drawable/bg_intro_phone_frame"
            android:clipToOutline="true">

            <!-- ========= Beat 1: Scanner ========= -->
            <com.cash.dash.IntroScannerFrameView
                android:id="@+id/introScanFrame"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center" />

            <!-- ========= Beat 2: Amount ========= -->
            <LinearLayout
                android:id="@+id/introScanAmountGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">
                
                <!-- Drag handle mimic -->
                <View
                    android:layout_width="20dp"
                    android:layout_height="2dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="12dp"
                    android:background="?attr/progressTrackColor" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Receiver: Person X"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="UPI ID: personx@upi"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/introScanAmountField"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="12dp"
                    android:background="?attr/inputBackground"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="14sp"
                    tools:text="100" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:text="@string/intro_scan_wallet_balance"
                    android:textColor="?attr/textMutedColor"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/introScanPayBtn"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_intro_cta"
                    android:gravity="center"
                    android:text="@string/intro_scan_pay_amount"
                    android:textColor="?attr/primaryActionText"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ========= Beat 3: Allocation ========= -->
            <LinearLayout
                android:id="@+id/introScanAllocGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <!-- Drag handle mimic -->
                <View
                    android:layout_width="20dp"
                    android:layout_height="2dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="10dp"
                    android:background="?attr/progressTrackColor" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Choose Expense Allocation"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <!-- + Create New Allocation Button -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_intro_mini_card"
                    android:gravity="center"
                    android:text="+ Create New Allocation"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="8sp" />

                <Space android:layout_width="match_parent" android:layout_height="4dp" />

                <!-- Skip allocation Button -->
                <!-- Skip allocation Button -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_intro_mini_card"
                    android:backgroundTint="#40FF0000"

                    android:gravity="center"
                    android:text="Skip allocation"
                    android:textColor="#FFCCCC"
                    android:textSize="8sp"
                    android:textStyle="bold" />


                <Space android:layout_width="match_parent" android:layout_height="8dp" />

                <!-- Food row -->
                <LinearLayout
                    android:id="@+id/introScanAllocFood"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_intro_mini_card"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp">

                    <!-- Top: Icon & Title -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"
                            android:background="?attr/iconBackground">
                            <ImageView
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_category_food"
                                android:tint="?attr/textPrimaryColor"
                                android:contentDescription="@null" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Food"
                            android:textColor="?attr/textPrimaryColor"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Middle: Progress Bar Mimic -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="6dp">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_glass_progress_outer" />
                        <!-- Purple Fill (approx 55%) -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="50dp"
                            android:background="@drawable/bg_glass_progress_fill" />
                    </FrameLayout>

                    <!-- Bottom: Spent / Limit -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:text="Spent: ₹350"
                            android:textColor="?attr/textPrimaryColor"
                            android:textSize="7sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="Limit: ₹650"
                            android:textColor="?attr/textPrimaryColor"
                            android:textSize="7sp" />
                    </RelativeLayout>
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="6dp" />

                <!-- Shopping row (RED) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_intro_mini_card"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <FrameLayout
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"
                            android:background="?attr/iconBackground">
                            <ImageView
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_category_shopping"
                                android:tint="?attr/textPrimaryColor"
                                android:contentDescription="@null" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Shopping"
                            android:textColor="?attr/textPrimaryColor"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="6dp">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_glass_progress_outer" />
                        <!-- Red Fill (100% Exceeded) -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_glass_progress_fill_red" />
                    </FrameLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:text="Spent: ₹350"
                            android:textColor="?attr/textPrimaryColor"
                            android:textSize="7sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="Limit: ₹200"
                            android:textColor="?attr/textPrimaryColor"
                            android:textSize="7sp" />
                    </RelativeLayout>
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="6dp" />

                <!-- Travel row (Empty) -->
                <LinearLayout
                    android:id="@+id/introScanAllocTravel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_intro_mini_card"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <FrameLayout
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"
                            android:background="?attr/iconBackground">
                            <ImageView
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_category_transport"
                                android:tint="?attr/textPrimaryColor"
                                android:contentDescription="@null" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Travel"
                            android:textColor="?attr/textPrimaryColor"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="6dp">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_glass_progress_outer" />
                    </FrameLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:text="Spent: ₹0"
                            android:textColor="?attr/textPrimaryColor"
                            android:textSize="7sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="Limit: ₹500"
                            android:textColor="?attr/textPrimaryColor"
                            android:textSize="7sp" />
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ========= Beat 4: Final ========= -->
            <LinearLayout
                android:id="@+id/introScanConfirmGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">
                
                <!-- Drag handle mimic -->
                <View
                    android:layout_width="20dp"
                    android:layout_height="2dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="12dp"
                    android:background="?attr/progressTrackColor" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Receiver: Person X"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="UPI ID: personx@upi"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="10dp"
                    android:background="?attr/inputBackground"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="100"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/intro_scan_allocated_to"
                        android:textColor="?attr/textMutedColor"
                        android:textSize="8sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_intro_chip"
                        android:paddingStart="6dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="3dp"
                        android:text="@string/intro_scan_change"
                        android:textColor="?attr/textPrimaryColor"
                        android:textSize="7sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/introScanFinalPayNow"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_intro_cta"
                    android:gravity="center"
                    android:text="Pay Now"
                    android:textColor="?attr/primaryActionText"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:text="@string/intro_scan_wallet_balance"
                    android:textColor="?attr/textMutedColor"
                    android:textSize="8sp" />
            </LinearLayout>

            <!-- ========= Beat 5: Success ========= -->
            <LinearLayout
                android:id="@+id/introScanSuccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_intro_cta"
                    android:backgroundTint="#4CAF50">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_intro_check"
                        android:tint="@android:color/white"
                        android:contentDescription="@null" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Payment Successful"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ========= Beat 6: Home ========= -->
            <FrameLayout
                android:id="@+id/introScanRingGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <com.cash.dash.IntroWalletRingView
                    android:id="@+id/introScanRing"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/introScanRingAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:includeFontPadding="false"
                        android:text="â‚¹2000"
                        android:textColor="?attr/textPrimaryColor"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/intro_wallet_label"
                        android:textColor="?attr/textMutedColor"
                        android:textSize="8sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            
        </FrameLayout>
            
    </LinearLayout>
</merge>
