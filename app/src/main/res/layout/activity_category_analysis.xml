<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none"
    android:background="?attr/mainBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="?attr/roundBackground"
            android:src="@drawable/ic_back_arrow1"
            android:padding="10dp"
            android:tint="?attr/textPrimaryColor"
            android:layout_marginTop="20dp" />

        <!-- Main Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Previous data analysis"
            android:textSize="20sp"
            android:textColor="?attr/textMutedColor"
            android:layout_marginTop="20dp"
            android:layout_gravity="center" />

        <!-- Category Title Group (ConstraintLayout for pinpoint centering) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp">
 
            <TextView
                android:id="@+id/tvCategoryName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FOOD"
                android:textSize="42sp"
                android:textStyle="bold"
                android:textColor="?attr/textPrimaryColor"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
 
            <ImageView
                android:id="@+id/btnEditIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_edit"
                android:tint="?attr/textPrimaryColor"
                android:padding="2dp"
                android:layout_marginStart="12dp"
                android:background="@null"
                app:layout_constraintStart_toEndOf="@id/tvCategoryName"
                app:layout_constraintTop_toTopOf="@id/tvCategoryName"
                app:layout_constraintBottom_toBottomOf="@id/tvCategoryName" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tvLimitValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Limit: ₹0"
            android:textSize="18sp"
            android:textColor="#A0A0A0"
            android:gravity="center"
            android:layout_marginBottom="10dp"
            android:visibility="gone" />

        <!-- Separator Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/textMutedColor"
            android:alpha="0.2"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:layout_marginBottom="20dp" />
        <!-- Graph Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="10dp">

            <!-- Custom Bar Graph -->
            <com.cash.dash.WeeklyBarGraphView
                android:id="@+id/weeklyGraph"
                android:layout_width="match_parent"
                android:layout_height="250dp" />

        </LinearLayout>

        <!-- Graph Bottom Label -->
        <TextView
            android:id="@+id/tvGraphBottomText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Data analysis from the past 4 weeks"
            android:textColor="?attr/textMutedColor"
            android:gravity="center"
            android:textSize="15sp"
            android:layout_marginTop="10dp"/>

        <!-- Average Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="25dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avg : "
                android:textSize="22sp"
                android:textColor="?attr/textMutedColor" />

            <TextView
                android:id="@+id/tvAverage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹1015.5"
                android:textSize="22sp"
                android:textColor="?attr/textPrimaryColor"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Info box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:layout_marginTop="30dp"
            android:background="?attr/glass3dBackground"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_white_circle"
                android:src="@drawable/ic_i_symbol"
                android:tint="#000000"
                android:padding="3dp"
                android:layout_marginEnd="15dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="The limit you are setting will not block/stop your payment when you exceed it. It is only for tracking purposes."
                android:textColor="?attr/textPrimaryColor"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp"/>

        </LinearLayout>

        <!-- SET LIMIT BUTTON -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSetLimit"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="30dp"
            android:background="?attr/glass3dBackground"
            android:backgroundTint="@null"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:text="SET LIMIT"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?attr/textPrimaryColor" />

    </LinearLayout>

</ScrollView>
