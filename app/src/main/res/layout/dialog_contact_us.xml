<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="25dp"
    android:background="?attr/transactionItemBackground"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Contact Support"
        android:textColor="?attr/textPrimaryColor"
        android:textSize="@dimen/text_title"
        android:textStyle="bold"
        android:layout_marginBottom="25dp"/>

    <!-- Read-only Name -->
    <TextView
        android:id="@+id/tvContactName"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="?attr/inputBackground"
        android:gravity="center_vertical"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:textColor="?attr/textMutedColor"
        android:textSize="@dimen/text_body"
        android:layout_marginBottom="12dp"
        android:text="Name: —"/>

    <!-- Read-only Time -->
    <TextView
        android:id="@+id/tvContactTime"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="?attr/inputBackground"
        android:gravity="center_vertical"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:textColor="?attr/textMutedColor"
        android:textSize="@dimen/text_body"
        android:layout_marginBottom="12dp"
        android:text="Time: —"/>

    <!-- Read-only Email -->
    <TextView
        android:id="@+id/tvContactEmail"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="?attr/inputBackground"
        android:gravity="center_vertical"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:textColor="?attr/textMutedColor"
        android:textSize="@dimen/text_body"
        android:layout_marginBottom="12dp"
        android:text="Email: —"/>

    <!-- Subject Input -->
    <EditText
        android:id="@+id/edtContactSubject"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="?attr/inputBackground"
        android:hint="Subject - Regarding?"
        android:textColorHint="?attr/textMutedColor"
        android:textColor="?attr/textPrimaryColor"
        android:gravity="center_vertical"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:inputType="textCapSentences"
        android:textSize="@dimen/text_body"
        android:layout_marginBottom="12dp"/>

    <!-- Query Input -->
    <EditText
        android:id="@+id/edtContactQuery"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="?attr/inputBackground"
        android:hint="Mention your query"
        android:textColorHint="?attr/textMutedColor"
        android:textColor="?attr/textPrimaryColor"
        android:gravity="top"
        android:padding="15dp"
        android:inputType="textMultiLine|textCapSentences"
        android:textSize="@dimen/text_body"
        android:layout_marginBottom="25dp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnContactSubmit"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="?attr/cardBackground"
        android:backgroundTint="@null"
        android:text="Submit"
        android:textColor="?attr/textPrimaryColor"
        android:textStyle="bold"
        android:textSize="@dimen/text_subhead"
        android:textAllCaps="false"
        android:stateListAnimator="@null"
        android:elevation="0dp"/>

</LinearLayout>
