<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/mainBackground"
    android:padding="24dp"
    android:clipToPadding="false">

    <!-- Drag Handle -->
    <View
        android:id="@+id/dragHandle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="?attr/textMutedColor"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/tvSheetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Date of Birth and Gender"
        android:textColor="?attr/textPrimaryColor"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvSheetHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Note: These are permanent and cannot be changed."
        android:textColor="?attr/textRedColor"
        android:textSize="@dimen/text_body"
        android:textStyle="bold"
        android:maxLines="2"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp" />

    <!-- Matches the GENDER label below, so the sheet reads as two labelled sections
         rather than a bare set of wheels followed by a labelled row. -->
    <TextView
        android:id="@+id/tvDobLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DATE OF BIRTH"
        android:textColor="?attr/textPrimaryColor"
        android:textSize="10sp"
        android:letterSpacing="0.1"
        android:alpha="0.5"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="8dp" />

    <!-- Pickers Row -->
    <LinearLayout
        android:id="@+id/layoutDobPickers"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="3"
        android:layout_marginBottom="24dp">

        <NumberPicker
            android:id="@+id/pickerYear"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <NumberPicker
            android:id="@+id/pickerMonth"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <NumberPicker
            android:id="@+id/pickerDay"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- GENDER
         Same construction as the rest of the form: plain TextViews on
         ?attr/inputBackground, whose state_selected variant every theme already
         defines. Lives in this sheet rather than on the register screen so date
         of birth and gender are chosen, and warned about, in one place. -->
    <TextView
        android:id="@+id/tvGenderLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GENDER"
        android:textColor="?attr/textPrimaryColor"
        android:textSize="10sp"
        android:letterSpacing="0.1"
        android:alpha="0.5"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:id="@+id/layoutGenderChips"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/chipGenderMale"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="?attr/inputBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="2"
            android:paddingHorizontal="4dp"
            android:text="Male"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/chipGenderFemale"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/inputBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="2"
            android:paddingHorizontal="4dp"
            android:text="Female"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/chipGenderUnspecified"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="?attr/inputBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="2"
            android:paddingHorizontal="4dp"
            android:text="Prefer not to say"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Save Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSaveDate"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="Save"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textSize="@dimen/text_subhead"
        android:textColor="?attr/textPrimaryColor"
        android:background="?attr/cardBackground"
        android:backgroundTint="@null"
        android:elevation="0dp"
        android:stateListAnimator="@null" />

</LinearLayout>
