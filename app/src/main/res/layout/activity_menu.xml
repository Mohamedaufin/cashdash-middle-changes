<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mainBackground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="25dp"
            android:paddingTop="30dp"
            android:paddingBottom="75dp">

            <!-- TOP NAV BAR -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="25dp">

                <ImageButton
                    android:id="@+id/btnCloseMenu"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="?attr/roundBackground"
                    android:padding="12dp"
                    android:src="@drawable/ic_back_arrow1"
                    android:scaleType="fitCenter"
                    app:tint="?attr/textPrimaryColor"
                    android:layout_alignParentStart="true"/>
            </RelativeLayout>

            <!-- PROFILE HEADER -->
            <LinearLayout
                android:id="@+id/layoutProfileHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="20dp"
                android:background="?attr/cardBackground"
                android:layout_marginBottom="35dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgProfile"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_profile"
                    android:background="?attr/borderedRoundBackground"
                    app:tint="?attr/textPrimaryColor"
                    android:padding="5dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="20dp">

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hello,"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="User"
                        android:textColor="?attr/textPrimaryColor"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnProfileOptions"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_more_vert"
                    app:tint="?attr/textMutedColor" />
            </LinearLayout>

            <!-- MENU ITEMS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">




                <!-- Wallet Bar (formerly Balance Bar) -->
                <LinearLayout
                    android:id="@+id/btnBalanceBar"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginBottom="15dp"
                    android:background="?attr/transactionBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_wallet_vector"
                        app:tint="?attr/textPrimaryColor" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:text="Wallet Balance"
                        android:textColor="?attr/textPrimaryColor"
                        android:textSize="@dimen/text_subhead"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Update Money Schedule -->
                <LinearLayout
                    android:id="@+id/btnUpdateSchedule"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginBottom="15dp"
                    android:background="?attr/transactionBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_calendar_vector"
                        app:tint="?attr/textPrimaryColor" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:text="Money Schedule"
                        android:textColor="?attr/textPrimaryColor"
                        android:textSize="@dimen/text_subhead"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Theme -->
                <LinearLayout
                    android:id="@+id/btnTheme"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginBottom="15dp"
                    android:background="?attr/transactionBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_palette_vector"
                        app:tint="?attr/textPrimaryColor" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:text="Appearance"
                        android:textColor="?attr/textPrimaryColor"
                        android:textSize="@dimen/text_subhead"
                        android:textStyle="bold" />
                </LinearLayout>



                <!-- Privacy Policy -->
                <LinearLayout
                    android:id="@+id/btnPrivacyPolicy"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginBottom="15dp"
                    android:background="?attr/transactionBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_shield_vector"
                        app:tint="?attr/textPrimaryColor" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:text="Privacy Policy"
                        android:textColor="?attr/textPrimaryColor"
                        android:textSize="@dimen/text_subhead"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Smart Assistant -->


            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.drawerlayout.widget.DrawerLayout>
