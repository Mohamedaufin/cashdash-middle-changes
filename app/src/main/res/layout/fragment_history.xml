<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="30dp"

    android:paddingBottom="20dp">
    <!-- TOP FILTER BUTTONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="10dp">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDaily"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:background="?attr/inputBackground"
            android:backgroundTint="@null"
            android:text="Daily"
            android:drawableEnd="@drawable/ic_arrow_drop_down"
            android:drawableTint="@color/text_dim"
            android:paddingEnd="12dp"
            android:paddingStart="16dp"
            android:textAllCaps="false"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="12dp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:elevation="0dp" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDate"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/inputBackground"
            android:backgroundTint="@null"
            android:text="--/--/----"
            android:drawableEnd="@drawable/ic_arrow_drop_down"
            android:drawableTint="@color/text_dim"
            android:paddingEnd="12dp"
            android:paddingStart="16dp"
            android:textAllCaps="false"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="12dp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:elevation="0dp" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnOverall"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:background="?attr/inputBackground"
            android:backgroundTint="@null"
            android:text="Overall"
            android:drawableEnd="@drawable/ic_arrow_drop_down"
            android:drawableTint="@color/text_dim"
            android:paddingEnd="12dp"
            android:paddingStart="16dp"
            android:textAllCaps="false"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="12dp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:elevation="0dp" />
    </LinearLayout>
    <!-- SEARCH BAR -->
    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        android:background="?attr/inputBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="15dp">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_search"
            app:tint="@color/text_secondary" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Search transactions"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body" />
    </LinearLayout>
    
    <!-- GRAPH HINT -->
    <TextView
        android:id="@+id/tvGraphHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:text="Click on any graph to view daily breakdown"
        android:textColor="@color/text_secondary"
        android:textSize="12dp" />

    <!-- GRAPH -->
    <com.cash.dash.DayBarGraphView
        android:id="@+id/dayGraph"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="15dp" />
    <!-- GRAPH TITLE -->
    <TextView
        android:id="@+id/tvGraphTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Daily Spending"
        android:textColor="?attr/textPrimaryColor"
        android:textSize="@dimen/text_subhead"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginTop="15dp" />
    <!-- SPLIT ACTION BUTTONS (Side-by-Side Row at Bottom) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:weightSum="2">
        <!-- FINANCIAL REPORT BUTTON -->
        <LinearLayout
            android:id="@+id/cardReport"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="?attr/cardBackground"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/iconReport"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_search"
                app:tint="?attr/textPrimaryColor"
                android:layout_marginBottom="8dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Financial Report"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"/>
        </LinearLayout>
        <!-- VIEW STATEMENT BUTTON -->
        <LinearLayout
            android:id="@+id/cardStatement"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="?attr/cardBackground"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/iconStatement"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_paper_sheet"
                app:tint="?attr/textPrimaryColor"
                android:layout_marginBottom="8dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Generate Statement"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
