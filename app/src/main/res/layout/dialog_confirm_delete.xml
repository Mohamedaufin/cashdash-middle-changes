<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="28dp"
    android:paddingEnd="28dp"
    android:paddingBottom="24dp"
    android:background="?attr/transactionItemBackground">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Delete Notification?"
        android:textColor="?attr/textPrimaryColor"
        android:textSize="@dimen/text_title"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="This notification will be permanently removed."
        android:textColor="?attr/textMutedColor"
        android:textSize="@dimen/text_body"
        android:gravity="center"
        android:layout_marginBottom="28dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelDelete"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="54dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            android:background="?attr/cardBackground"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:layout_marginEnd="8dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConfirmDelete"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="54dp"
            android:text="Delete"
            android:textAllCaps="false"
            android:textColor="?attr/textRedColor"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            android:background="?attr/cardBackground"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>
