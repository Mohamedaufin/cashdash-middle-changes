<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/mainBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="50dp"
    android:paddingBottom="0dp">

    <ImageView
        android:id="@+id/btnBack"
        android:src="@drawable/ic_back_arrow1"
        android:background="?attr/roundBackground"
        android:padding="12dp"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:tint="?attr/textPrimaryColor" />

    <TextView
        android:id="@+id/tvDetailTitle"
        android:text="Breakdown"
        android:textColor="?attr/textPrimaryColor"
        android:textSize="@dimen/text_title"
        android:layout_marginTop="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <com.cash.dash.CategoryBreakdownGraphView
        android:id="@+id/categoryGraph"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_marginTop="20dp" />

    <TextView
        android:text="History"
        android:textColor="?attr/textPrimaryColor"
        android:textSize="@dimen/text_title"
        android:layout_marginTop="15dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tvReceiptHint"
        android:text="Tap any scanned transaction to view its receipt"
        android:textColor="?attr/textMutedColor"
        android:textSize="12dp"
        android:layout_marginTop="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tvEditHint"
        android:text="Press and hold on any transaction to edit it"
        android:textColor="?attr/textMutedColor"
        android:textSize="12dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerTransactions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingBottom="120dp"
        android:clipToPadding="false" />

</LinearLayout>
