<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="16dp"
    android:background="?attr/cardBackground">

    <!-- Top accent bar + title row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="18dp"
        android:paddingBottom="12dp">

        <!-- Colored left accent bar -->
        <View
            android:id="@+id/viewAccentBar"
            android:layout_width="4dp"
            android:layout_height="36dp"
            android:background="#8BF7E6"
            android:layout_marginEnd="14dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Status badge (QUERY RESPONDED / WAITING FOR RESPONSE) -->
            <TextView
                android:id="@+id/tvNotificationTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Query Responded"
                android:textColor="#8BF7E6"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:letterSpacing="0.12"
                android:layout_marginBottom="3dp"/>

            <!-- Time-stamp right aligned -->
            <TextView
                android:id="@+id/tvNotificationTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08 Mar, 05:18 PM"
                android:textColor="?attr/textMutedColor"
                android:textSize="@dimen/text_caption"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Thin separator below header -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#15808080"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"/>

    <!-- Dynamic Timeline Container -->
    <LinearLayout
        android:id="@+id/layoutTimelineContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:paddingBottom="4dp" />

    <!-- Legacy Views kept hidden to avoid compilation issues -->
    <TextView
        android:id="@+id/tvNotificationQuery"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvAttachmentLabel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/layoutAttachments"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvNotificationReply"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"/>

    <!-- Reply Input Section -->
    <LinearLayout
        android:id="@+id/layoutReplyBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingTop="0dp"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#10808080"
            android:layout_marginBottom="14dp"/>

        <!-- Horizontal scroll for reply image previews -->
        <HorizontalScrollView
            android:id="@+id/scrollReplyPreviews"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/layoutReplyPreviews"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"/>
        </HorizontalScrollView>

        <!-- Upload Progress Section (shown only during image upload) -->
        <LinearLayout
            android:id="@+id/layoutUploadProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvUploadStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Uploading image 1 of 1…"
                android:textColor="?attr/textMutedColor"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"/>

            <ProgressBar
                android:id="@+id/progressUpload"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#7C4DFF"
                android:progressBackgroundTint="#22FFFFFF"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:background="?attr/inputBackground"
            android:padding="4dp">

            <EditText
                android:id="@+id/edtReply"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Type your reply..."
                android:textColor="?attr/textPrimaryColor"
                android:textColorHint="?attr/textMutedColor"
                android:background="@android:color/transparent"
                        android:textSize="@dimen/text_caption"
                android:minHeight="48dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="4"/>

            <ImageButton
                android:id="@+id/btnAttachMedia"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_gallery"
                android:padding="16dp"
                android:scaleType="fitCenter"
                app:tint="?attr/textPrimaryColor"/>

            <ImageButton
                android:id="@+id/btnSendReply"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_send"
                android:padding="16dp"
                android:scaleType="fitCenter"
                app:tint="?attr/textPrimaryColor"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Resolved Status Footer Overlay (Optional indicator) -->

    <!-- Resolved Status Footer Overlay (Optional indicator) -->
    <TextView
        android:id="@+id/tvResolvedStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✔ Query Resolved"
        android:textColor="?attr/textMutedColor"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:textAllCaps="false"
        android:letterSpacing="0.1"/>

</LinearLayout>
