<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scannerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#000000">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />

    <!-- Container for centered frame and gallery button -->

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_gravity="center">

        <!-- 🔥 Neon Scanner Frame Overlay -->
        <View
            android:id="@+id/neonFrame"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:background="@drawable/neon_border"
            android:visibility="visible"/>

        <!-- 📁 Gallery Import Button (Capsule) -->
        <LinearLayout
            android:id="@+id/btnGallery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_capsule_themed">

            <ImageView
                android:id="@+id/imgGalleryIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_gallery_modern"
                app:tint="#FFFFFF"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tvGalleryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upload from gallery"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Close Button -->
    <ImageButton
        android:id="@+id/btnCloseScanner"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_margin="25dp"
        android:background="@drawable/bg_circle_black_transparent"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:scaleType="fitCenter"
        app:tint="#FFFFFF"
        android:layout_gravity="top|start"/>

    <!-- Flashlight Button -->
    <ImageButton
        android:id="@+id/btnFlashlight"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:background="@drawable/bg_circle_black_transparent"
        android:padding="14dp"
        android:src="@drawable/ic_flashlight_off"
        android:scaleType="fitCenter"
        app:tint="#FFFFFF"
        android:layout_gravity="top|end"/>

    <!-- History Button (Top-Right) -->
    <ImageButton
        android:id="@+id/btnHistory"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_margin="25dp"
        android:background="@drawable/bg_circle_black_transparent"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_revert"
        android:scaleType="fitCenter"
        app:tint="#FFFFFF"
        android:layout_gravity="top|end"/>

    <!-- More Menu Button (3 dots) -->
    <ImageButton
        android:id="@+id/btnMore"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_margin="25dp"
        android:background="@drawable/bg_circle_black_transparent"
        android:padding="12dp"
        android:src="@drawable/ic_more_vert"
        android:scaleType="fitCenter"
        app:tint="#FFFFFF"
        android:layout_gravity="bottom|end"/>

</FrameLayout>
