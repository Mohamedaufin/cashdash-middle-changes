<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mainBackground"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="25dp"
            android:paddingTop="4dp"
            android:paddingBottom="75dp">

            <!-- TOP NAV BAR -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:layout_marginBottom="25dp">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/roundBackground"
                    android:padding="12dp"
                    android:src="@drawable/ic_back_arrow1"
                    app:tint="?attr/textPrimaryColor"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="60dp"
                    android:text="TapTrack"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold"
                    android:gravity="center"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Instructions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?attr/cardBackground"
                android:padding="20dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Smart Tracking Assistant"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="@dimen/text_subhead"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Meet TapTrack, your digital finance pet that activates whenever you open a supported app. "
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body"
                    android:layout_marginBottom="10dp"/>
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• It pops up as a floating bubble on top of supported app, letting you record your expenses on the go."
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body"
                    android:layout_marginBottom="10dp"/>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Supported apps: Amazon, Flipkart, Swiggy, Zomato, Zepto, Blinkit, BigBasket, Myntra, Rapido, Uber, Ola, Ajio, Meesho, RedBus, IRCTC Rail Connect, RedTaxi."
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="16dp"/>

                <!-- Privacy Guarantee -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?attr/transactionBackground"
                    android:padding="15dp">
                    
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_shield_vector"
                        app:tint="?attr/textGreenColor"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Your data is not collected or sent to us. We don't track user data. Everything runs locally on your device."
                        android:textColor="?attr/textPrimaryColor"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Master Toggle Bar -->
            <LinearLayout
                android:id="@+id/masterToggleContainer"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginBottom="20dp"
                android:background="?attr/transactionBackground"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <ImageView
                    android:id="@+id/iconTaptrackStatus"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_taptrack_icon"
                    app:tint="?attr/textPrimaryColor" />

                <TextView
                    android:id="@+id/tvTaptrackStatus"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="TapTrack is off"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="@dimen/text_subhead"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchTaptrack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/switch_thumb_color"
                    app:trackTint="@color/switch_track_color"
                    app:track="@drawable/custom_switch_track_base" />
            </LinearLayout>

            <!-- Quick Toggle Hint Text -->
            <TextView
                android:id="@+id/tvTapTrackHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Press and hold the TapTrack icon from the home page to quickly turn on/off TapTrack."
                android:textColor="?attr/textMutedColor"
                android:textSize="11dp"
                android:gravity="center"
                android:layout_marginBottom="20dp"
                android:visibility="visible"/>

            <!-- Draw Overlays Permission Block (Hidden by default) -->
            <LinearLayout
                android:id="@+id/layoutOverlayPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="15dp"
                android:background="?attr/transactionBackground"
                android:padding="20dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Enable Draw Over Other Apps"
                        android:textColor="?attr/textPrimaryColor"
                        android:textSize="@dimen/text_subhead"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchOverlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/switch_thumb_color"
                        app:trackTint="@color/switch_track_color"
                        app:track="@drawable/custom_switch_track_base" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="This permission is required to display the floating bubble on top of supported app."
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <!-- Usage Stats Permission Block (Hidden by default) -->
            <LinearLayout
                android:id="@+id/layoutUsagePermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="15dp"
                android:background="?attr/transactionBackground"
                android:padding="20dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Enable Usage Data Access"
                        android:textColor="?attr/textPrimaryColor"
                        android:textSize="@dimen/text_subhead"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchUsage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/switch_thumb_color"
                        app:trackTint="@color/switch_track_color"
                        app:track="@drawable/custom_switch_track_base" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="This permission allows CashDash to securely detect when you open a supported app."
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>
