<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mainBackground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="25dp"
            android:paddingTop="30dp"
            android:paddingBottom="75dp">

            <!-- TOP NAV BAR -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="25dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="?attr/roundBackground"
                    android:padding="12dp"
                    android:src="@drawable/ic_back_arrow1"
                    android:scaleType="fitCenter"
                    app:tint="?attr/textPrimaryColor"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="Taptrack"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Instructions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?attr/cardBackground"
                android:padding="20dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Smart Shopping Assistant"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="@dimen/text_subhead"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Automatically detects when you open shopping apps."
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body"
                    android:layout_marginBottom="10dp"/>
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Provides a floating bubble to instantly check your wallet balance and remaining limits before you spend."
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Eliminates the need of using CashDash Rigor Tracker later to record expense manually."
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Supported apps: Amazon, Flipkart, Swiggy, Zomato, Zepto, Blinkit, BigBasket, Myntra, Rapido, Uber, Ola, Ajio, Meesho, RedBus, IRCTC Rail Connect, RedTaxi."
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="16dp"/>

                <!-- Privacy Guarantee -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?attr/transactionBackground"
                    android:padding="15dp">
                    
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_shield_vector"
                        app:tint="#4CAF50"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Your data is not collected or sent to us. We don't track user data. Everything runs locally on your device."
                        android:textColor="?attr/textPrimaryColor"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Master Toggle Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginBottom="15dp"
                android:background="?attr/transactionBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <ImageView
                    android:id="@+id/iconTaptrackStatus"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_taptrack_icon"
                    app:tint="?attr/textPrimaryColor" />

                <TextView
                    android:id="@+id/tvTaptrackStatus"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="Taptrack is off"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="@dimen/text_subhead"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchTaptrack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/switch_thumb_color"
                    app:trackTint="@color/switch_track_color"
                    app:track="@drawable/custom_switch_track_base" />
            </LinearLayout>

            <!-- Draw Overlays Permission Block (Hidden by default) -->
            <LinearLayout
                android:id="@+id/layoutOverlayPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="15dp"
                android:background="?attr/transactionBackground"
                android:padding="20dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Enable Draw Over Other Apps"
                        android:textColor="?attr/textPrimaryColor"
                        android:textSize="@dimen/text_subhead"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchOverlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/switch_thumb_color"
                        app:trackTint="@color/switch_track_color"
                        app:track="@drawable/custom_switch_track_base" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="This permission is required to display the floating wallet bubble on top of shopping apps."
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <!-- Usage Stats Permission Block (Hidden by default) -->
            <LinearLayout
                android:id="@+id/layoutUsagePermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="15dp"
                android:background="?attr/transactionBackground"
                android:padding="20dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Enable Usage Data Access"
                        android:textColor="?attr/textPrimaryColor"
                        android:textSize="@dimen/text_subhead"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchUsage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/switch_thumb_color"
                        app:trackTint="@color/switch_track_color"
                        app:track="@drawable/custom_switch_track_base" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="This permission allows CashDash to securely detect when you open a shopping application."
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.drawerlayout.widget.DrawerLayout>
