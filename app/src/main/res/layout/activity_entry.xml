<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="28dp"
    android:gravity="center"
    android:background="?attr/mainBackground">

    <!-- Header Section -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CashDash"
        android:textColor="?attr/textPrimaryColor"
        android:textSize="@dimen/text_headline"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Manage your wealth wisely"
        android:textColor="?attr/textMutedColor"
        android:textSize="@dimen/text_subhead"
        android:layout_marginBottom="40dp" />

    <!-- Flow Selection Buttons -->
    <LinearLayout
        android:id="@+id/layoutSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSelectLogin"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="Login"
            android:textStyle="bold"
            android:textSize="@dimen/text_subhead"
            android:textAllCaps="false"
            android:background="?attr/cardBackground"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:textColor="?attr/textPrimaryColor"
            android:layout_marginBottom="16dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSelectRegister"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="Register"
            android:textStyle="bold"
            android:textSize="@dimen/text_subhead"
            android:textAllCaps="false"
            android:background="?attr/cardBackground"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:textColor="?attr/textPrimaryColor" />
    </LinearLayout>

    <!-- Auth Form Section (Hidden Initially) -->
    <LinearLayout
        android:id="@+id/layoutAuthForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- FULL NAME -->
        <EditText
            android:id="@+id/edtName"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="?attr/inputBackground"
            android:hint="Name"
            android:textColor="?attr/textPrimaryColor"
            android:textColorHint="@color/text_dim"
            android:padding="16dp"
            android:inputType="textPersonName|textCapWords"
            android:importantForAutofill="noExcludeDescendants"
            android:layout_marginBottom="16dp"/>

        <!-- PHONE NUMBER -->
        <EditText
            android:id="@+id/edtPhone"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="?attr/inputBackground"
            android:hint="Phone Number"
            android:textColor="?attr/textPrimaryColor"
            android:textColorHint="@color/text_dim"
            android:padding="16dp"
            android:inputType="phone"
            android:importantForAutofill="noExcludeDescendants"
            android:layout_marginBottom="16dp"/>

        <!-- DATE OF BIRTH -->
        <TextView
            android:id="@+id/tvDob"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="?attr/inputBackground"
            android:hint="Date of Birth and Gender"
            android:textColor="?attr/textPrimaryColor"
            android:textColorHint="@color/text_dim"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"/>

        <!-- EMAIL -->
        <EditText
            android:id="@+id/edtEmail"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="?attr/inputBackground"
            android:hint="Email"
            android:textColor="?attr/textPrimaryColor"
            android:textColorHint="@color/text_dim"
            android:padding="16dp"
            android:inputType="textEmailAddress"
            android:autofillHints="emailAddress"
            android:importantForAutofill="yes"
            android:layout_marginBottom="16dp"/>

        <!-- PASSWORD -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">
            
            <EditText
                android:id="@+id/edtPassword"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="?attr/inputBackground"
                android:hint="Password"
                android:textColor="?attr/textPrimaryColor"
                android:textColorHint="@color/text_dim"
                android:paddingLeft="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:paddingRight="48dp"
                android:inputType="textPassword"
                android:autofillHints="password"
                android:importantForAutofill="yes" />

            <ImageView
                android:id="@+id/ivTogglePassword"
                android:layout_width="48dp"
                android:layout_height="60dp"
                android:layout_gravity="end|center_vertical"
                android:padding="14dp"
                android:src="@drawable/ic_eye_off"
                app:tint="@color/text_dim"
                android:clickable="true"
                android:focusable="true"/>
        </FrameLayout>

        <!-- TERMS & PRIVACY (Register Only) -->
        <LinearLayout
            android:id="@+id/layoutTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <CheckBox
                android:id="@+id/cbTerms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-12dp"
                android:minHeight="48dp" />

            <TextView
                android:id="@+id/tvTerms"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="I agree to the Terms of Service and Privacy Policy"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="14sp"
                android:lineSpacingExtra="6dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAction"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="Continue"
            android:textStyle="bold"
            android:textSize="@dimen/text_subhead"
            android:textAllCaps="false"
            android:background="?attr/cardBackground"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:textColor="#FFFFFF" />

        <!-- Login only. showAuthForm() hides this whole block on the Register tab, since
             Google sign-in here opens an existing account and never creates one. -->
        <LinearLayout
            android:id="@+id/layoutGoogleSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/border" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="or"
                    android:textColor="?attr/textMutedColor"
                    android:textSize="@dimen/text_body"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/border" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnGoogleSignIn"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:background="?attr/cardBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_google_logo"
                    android:contentDescription="Google" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Continue with Google"
                    android:textColor="?attr/textPrimaryColor"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:textSize="@dimen/text_subhead" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvBackToSelection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:text="Back"
            android:textColor="?attr/textMutedColor"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            android:padding="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvForgotPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Forgot Password?"
        android:textColor="?attr/textMutedColor"
        android:textSize="@dimen/text_body"
        android:textStyle="bold"
        android:padding="8dp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        android:indeterminateTint="#8BF7E6" />
        
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textAlignment="center"
        android:textColor="#FF6B6B"
        android:textSize="@dimen/text_body" />

</LinearLayout>
