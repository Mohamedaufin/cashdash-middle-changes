<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="28dp"
    android:gravity="center"
    android:background="?attr/mainBackground">

    <!-- Header Section -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CashDash"
        android:textColor="?attr/textPrimaryColor"
        android:textSize="@dimen/text_headline"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Manage your wealth wisely"
        android:textColor="?attr/textMutedColor"
        android:textSize="@dimen/text_subhead"
        android:layout_marginBottom="40dp" />

    <!-- Flow Selection Buttons -->
    <LinearLayout
        android:id="@+id/layoutSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSelectLogin"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="Login"
            android:textStyle="bold"
            android:textSize="@dimen/text_subhead"
            android:textAllCaps="false"
            android:background="?attr/cardBackground"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:textColor="?attr/textPrimaryColor"
            android:layout_marginBottom="16dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSelectRegister"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="Register"
            android:textStyle="bold"
            android:textSize="@dimen/text_subhead"
            android:textAllCaps="false"
            android:background="?attr/cardBackground"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:textColor="?attr/textPrimaryColor" />
    </LinearLayout>

    <!-- Auth Form Section (Hidden Initially) -->
    <LinearLayout
        android:id="@+id/layoutAuthForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- FULL NAME -->
        <EditText
            android:id="@+id/edtName"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="?attr/inputBackground"
            android:hint="Name"
            android:textColor="?attr/textPrimaryColor"
            android:textColorHint="@color/text_dim"
            android:padding="16dp"
            android:inputType="textPersonName|textCapWords"
            android:importantForAutofill="noExcludeDescendants"
            android:layout_marginBottom="16dp"/>

        <!-- PHONE NUMBER -->
        <EditText
            android:id="@+id/edtPhone"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="?attr/inputBackground"
            android:hint="Phone Number"
            android:textColor="?attr/textPrimaryColor"
            android:textColorHint="@color/text_dim"
            android:padding="16dp"
            android:inputType="phone"
            android:importantForAutofill="noExcludeDescendants"
            android:layout_marginBottom="16dp"/>

        <!-- EMAIL -->
        <EditText
            android:id="@+id/edtEmail"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="?attr/inputBackground"
            android:hint="Email"
            android:textColor="?attr/textPrimaryColor"
            android:textColorHint="@color/text_dim"
            android:padding="16dp"
            android:inputType="textEmailAddress"
            android:autofillHints="username,emailAddress"
            android:importantForAutofill="yes"
            android:layout_marginBottom="16dp"/>

        <!-- PASSWORD -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">
            
            <EditText
                android:id="@+id/edtPassword"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="?attr/inputBackground"
                android:hint="Password"
                android:textColor="?attr/textPrimaryColor"
                android:textColorHint="@color/text_dim"
                android:paddingLeft="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:paddingRight="48dp"
                android:inputType="textPassword"
                android:autofillHints="password"
                android:importantForAutofill="yes" />

            <ImageView
                android:id="@+id/ivTogglePassword"
                android:layout_width="48dp"
                android:layout_height="60dp"
                android:layout_gravity="end|center_vertical"
                android:padding="14dp"
                android:src="@drawable/ic_eye_off"
                app:tint="@color/text_dim"
                android:clickable="true"
                android:focusable="true"/>
        </FrameLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAction"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="Continue"
            android:textStyle="bold"
            android:textSize="@dimen/text_subhead"
            android:textAllCaps="false"
            android:background="?attr/cardBackground"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvBackToSelection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:text="Back"
            android:textColor="?attr/textMutedColor"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            android:padding="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvForgotPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Forgot Password?"
        android:textColor="?attr/textMutedColor"
        android:textSize="@dimen/text_body"
        android:textStyle="bold"
        android:padding="8dp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        android:indeterminateTint="#8BF7E6" />
        
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textAlignment="center"
        android:textColor="#FF6B6B"
        android:textSize="@dimen/text_body" />

</LinearLayout>
