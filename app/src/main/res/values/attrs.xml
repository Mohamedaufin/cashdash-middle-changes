    <!-- ic_finminder_white existed on disk but was reachable from nowhere: absent from
         ThemeHelper.getDrawable, not a theme attribute, never set in code. fragment_home
         referenced the dark asset directly, so the icon stayed dark on the White theme. -->
    <attr name="finminderIcon" format="reference" />
    <!-- Primary call to action, and the selected tab. Each theme fills these with maximum
         contrast against its own page rather than a shared brand colour: off-white on the
         dark themes, near-black on White. That is the pattern behind a white primary
         button on a dark app, and it keeps the CTA from competing with the accent. -->
    <attr name="primaryActionBackground" format="color" />
    <attr name="primaryActionText" format="color" />
    <!-- The exact colour the page starts with at the top, used to paint the status bar
         behind it. Held as an attribute so the bar and the page cannot drift apart: they
         were being set in three places with three different values, which is why a seam
         appeared under the status bar when the page ramps were retuned. If a
         bg_main_gradient_* start colour changes, change this with it. -->
    <attr name="pageTopColor" format="color" />
    <attr name="healthGreen" format="color" />
    <attr name="healthYellow" format="color" />
    <attr name="healthRed" format="color" />
    <attr name="progressTrackColor" format="color" />
    <attr name="dividerColor" format="color" />
    <attr name="textRedColor" format="color" />
    <attr name="textGreenColor" format="color" />
    <!-- The tick inside a checked box. Must be the inverse of textPrimaryColor,
         since that is what fills the box. -->
    <attr name="checkboxTickColor" format="color" />
    <item name="focus_clearer_tag" type="id" />
</resources>
