<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="bottomNavBackground" format="reference" />
    <attr name="mainBackground" format="reference" />
    <attr name="cardBackground" format="reference" />
    <attr name="glass3dBackground" format="reference" />
    <attr name="keypadBackground" format="reference" />
    <attr name="inputBackground" format="reference" />
    <attr name="panelBackground" format="reference" />
    <attr name="transactionBackground" format="reference" />
    <attr name="iconBackground" format="reference" />
    <attr name="transactionItemBackground" format="reference" />
    <attr name="keypadRoundedBackground" format="reference" />
    <attr name="dropdownBackground" format="reference" />
    <attr name="cardDarkBackground" format="reference" />
    <attr name="searchBackground" format="reference" />
    <attr name="roundBackground" format="reference" />
    <attr name="rigorCalendarBackground" format="reference|color" />
    <attr name="glass3dRedBackground" format="reference" />
    <attr name="borderedRoundBackground" format="reference" />
    <attr name="calendarTheme" format="reference" />

    <attr name="textPrimaryColor" format="color" />
    <attr name="textSecondaryColor" format="color" />
    <attr name="textMutedColor" format="color" />
    <attr name="navActiveColor" format="color" />
    <attr name="navInactiveColor" format="color" />
    <attr name="infoIconBackground" format="reference" />
    <!-- ic_finminder_white existed on disk but was reachable from nowhere: absent from
         ThemeHelper.getDrawable, not a theme attribute, never set in code. fragment_home
         referenced the dark asset directly, so the icon stayed dark on the White theme. -->
    <attr name="finminderIcon" format="reference" />
    <!-- Primary call to action, and the selected tab. Each theme fills these with maximum
         contrast against its own page rather than a shared brand colour: off-white on the
         dark themes, near-black on White. That is the pattern behind a white primary
         button on a dark app, and it keeps the CTA from competing with the accent. -->
    <attr name="primaryActionBackground" format="color" />
    <attr name="primaryActionText" format="color" />
    <!-- The exact colour the page starts with at the top, used to paint the status bar
         behind it. Held as an attribute so the bar and the page cannot drift apart: they
         were being set in three places with three different values, which is why a seam
         appeared under the status bar when the page ramps were retuned. If a
         bg_main_gradient_* start colour changes, change this with it. -->
    <attr name="pageTopColor" format="color" />
    <attr name="healthGreen" format="color" />
    <attr name="healthYellow" format="color" />
    <attr name="healthRed" format="color" />
    <attr name="progressTrackColor" format="color" />
    <attr name="dividerColor" format="color" />
    <attr name="textRedColor" format="color" />
    <attr name="textGreenColor" format="color" />
    <!-- The tick inside a checked box. Must be the inverse of textPrimaryColor,
         since that is what fills the box. -->
    <attr name="checkboxTickColor" format="color" />

    <!-- Palette for the pre-login intro animation. The artwork is flat line work, so it
         needs exactly three tones: the stroke, the surface a shape is filled with, and a
         recessed surface for anything that reads as behind or inside another shape.
         Each theme fills them from its own ramp so the illustration inverts with the app
         rather than sitting on a white card in the middle of a black page. -->
    <attr name="introInk" format="color" />
    <attr name="introSurface" format="color" />
    <attr name="introSurfaceDeep" format="color" />
    <!-- Drifting particles and the inactive page dots: present, never competing. -->
    <attr name="introMuted" format="color" />

    <declare-styleable name="ArcTextView">
        <attr name="arcText" format="string" />
        <attr name="arcTextSize" format="dimension" />
        <attr name="arcTextColor" format="color" />
        <!-- Centre of the circle the text rides on, as a fraction of the view box. -->
        <attr name="arcCenterX" format="float" />
        <attr name="arcCenterY" format="float" />
        <!-- Radius as a fraction of the view's width, so the arc keeps its shape
             whatever the view's aspect turns out to be. -->
        <attr name="arcRadius" format="float" />
        <!-- Degrees of arc the text is centred within, measured about twelve o'clock. -->
        <attr name="arcSweep" format="float" />
        <attr name="arcLetterSpacing" format="float" />
    </declare-styleable>

    <item name="focus_clearer_tag" type="id" />
    <!-- Which fill drawable an intro limit bar is currently wearing. Held as a tag so the
         bar's per-frame update can skip setBackgroundResource on every frame but the one
         where the bar actually crosses its limit. -->
    <item name="intro_bar_state_tag" type="id" />
</resources>
