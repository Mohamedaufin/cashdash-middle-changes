<resources>
    <string name="app_name">CashDash</string>
    <string name="accessibility_service_description">CashDash requires this permission to detect when you open shopping apps (like Swiggy or Zomato) so it can display the Floating Assistant widget. No personal data or screen content is collected.</string>
    <!-- No API keys here. String resources are plain text in the APK and are
         trivially extracted, so credentials live in Cloud Functions secrets and
         are reached through the rephraseSupportText callable. -->

    <!-- Pre-login intro. Each headline is split into a lead and a rest so the two halves
         can be coloured differently without hardcoding a character offset: the lead takes
         the page's primary text colour, the rest takes the theme's green. A lead of ""
         gives a headline that is green throughout. -->
    <string name="intro_one_lead">Welcome to</string>
    <string name="intro_one_rest">your world of financial clarity</string>
    <string name="intro_two_lead"></string>
    <string name="intro_two_rest">Effortless money management</string>
    <string name="intro_three_lead"></string>
    <string name="intro_three_rest">Track, plan and grow, all in one place</string>

    <string name="intro_brand_arc">CASHDASH</string>
    <string name="intro_continue">Get started</string>

    <!-- Intro tour (IntroTourActivity). Four pages in the order the product works: set what
         you have, pay from inside the app, see what the payment costs you, then the rest.
         Each page names a real feature and borrows that feature's own vocabulary, because the
         artwork behind the words is that feature's own screen. -->
    <string name="intro_tour_brand">CASHDASH</string>
    <string name="intro_tour_cta">Get started</string>
    <!-- The symbol is separated from the digits so grouping can come from an en-IN
         NumberFormat rather than a hardcoded pattern. -->
    <string name="intro_tour_amount">₹%1$s</string>

    <string name="intro_tour_one_eyebrow">01 — Wallet</string>
    <string name="intro_tour_one_title">Start with what you have</string>
    <string name="intro_tour_one_body">Set your wallet balance once. Everything CashDash does is measured against that number.</string>

    <string name="intro_tour_two_eyebrow">02 — Scan and allocate QR payments inside CashDash</string>
    <string name="intro_tour_two_title">Categorize right before you pay</string>
    <string name="intro_tour_two_body">Pick your allocation right before you pay — saving you the hassle of manually tracking expenses later.</string>

    <string name="intro_tour_three_eyebrow">03 — TapTrack</string>
    <string name="intro_tour_three_title">Track outside the app</string>
    <string name="intro_tour_three_body">Whenever you open Swiggy, Amazon or other apps, a floating bubble appears so you can log spends with 1 tap.</string>

    <string name="intro_tour_four_eyebrow">04 — And more</string>
    <string name="intro_tour_four_title">Catches every other rupee</string>
    <string name="intro_tour_four_body">From budget limits, to bill alerts and instant PDF statements.</string>

    <!-- Page 1. Sample figures, not anyone's data. -->
