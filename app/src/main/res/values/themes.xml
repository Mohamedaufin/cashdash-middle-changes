<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Cashdash" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="android:textAllCaps">false</item>
        <item name="android:autofilledHighlight">@android:color/transparent</item>
        <item name="buttonStyle">@style/Widget.Cashdash.Button</item>
        <item name="materialButtonStyle">@style/Widget.Cashdash.Button</item>
        <item name="textAppearanceButton">@style/Widget.Cashdash.Button.TextAppearance</item>
        <item name="colorPrimary">@color/primary_purple</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="textPrimaryColor">@color/text_primary</item>
        <item name="textMutedColor">@color/text_muted</item>
        <item name="navActiveColor">#FFFFFF</item>
        <item name="navInactiveColor">#D0E0FF</item>
        <item name="healthGreen">#26FF26</item>
        <item name="healthYellow">#FFC107</item>
        <item name="healthRed">#B71C1C</item>
        <item name="progressTrackColor">#262626</item>
    </style>


    <style name="keyBtn">
        <item name="android:layout_width">0dp</item>         <!-- takes space equally -->
        <item name="android:layout_height">0dp</item>        <!-- updated to 0dp to fix scaling -->
        <item name="android:layout_columnWeight">1</item>    <!-- forces equal width -->
        <item name="android:layout_margin">10dp</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">?attr/keypadBackground</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">?attr/textPrimaryColor</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- CALENDAR STYLING -->
    <style name="CalendarDateText">
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="CalendarWeekText">
        <item name="android:textColor">#333333</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>



    <style name="Widget.Cashdash.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Widget.Cashdash.Button.TextAppearance" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Theme.Cashdash" parent="Base.Theme.Cashdash">
        <item name="android:autofilledHighlight">@android:color/transparent</item>
        <item name="mainBackground">@drawable/bg_main_gradient</item>
        <item name="bottomNavBackground">@drawable/bg_3d_bottom_nav</item>
        <item name="cardBackground">@drawable/bg_3d_card</item>
        <item name="glass3dBackground">@drawable/bg_glass_3d</item>
        <item name="keypadBackground">@drawable/bg_glass_3d_keypad</item>
        <item name="inputBackground">@drawable/bg_glass_input</item>
        <item name="panelBackground">@drawable/bg_glass_panel</item>
        <item name="transactionBackground">@drawable/bg_glass_transaction</item>
        <item name="iconBackground">@drawable/bg_icon_dark</item>
        <item name="transactionItemBackground">@drawable/bg_transaction</item>
        <item name="keypadRoundedBackground">@drawable/keypad_white_rounded</item>
        <item name="dropdownBackground">@drawable/bg_3d_dropdown</item>
        <item name="cardDarkBackground">@drawable/bg_card_dark</item>
        <item name="searchBackground">@drawable/bg_glass_black</item>
        <item name="roundBackground">@drawable/bg_glass_3d_round</item>
        <item name="borderedRoundBackground">@drawable/bg_glass_3d_round</item>
        <item name="glass3dRedBackground">@drawable/bg_glass_3d_red</item>
        <item name="rigorCalendarBackground">@drawable/bg_glass_panel</item>
        <item name="calendarTheme">@style/CalendarThemeDark</item>
        <item name="textPrimaryColor">@color/text_primary</item>
        <item name="textMutedColor">@color/text_muted</item>
        <item name="navActiveColor">#FFFFFF</item>
        <item name="navInactiveColor">#D0E0FF</item>
        <item name="infoIconBackground">@drawable/bg_white_circle</item>
    </style>





    <style name="Theme.Cashdash.Blue" parent="Base.Theme.Cashdash">
        <item name="android:autofilledHighlight">@android:color/transparent</item>
        <item name="mainBackground">@drawable/bg_main_gradient_blue</item>
        <item name="bottomNavBackground">@drawable/bg_3d_bottom_nav_blue</item>
        <item name="cardBackground">@drawable/bg_3d_card_blue</item>
        <item name="glass3dBackground">@drawable/bg_glass_3d_blue</item>
        <item name="keypadBackground">@drawable/bg_glass_3d_keypad_blue</item>
        <item name="inputBackground">@drawable/bg_glass_input_blue</item>
        <item name="panelBackground">@drawable/bg_glass_panel_blue</item>
        <item name="transactionBackground">@drawable/bg_glass_transaction_blue</item>
        <item name="iconBackground">@drawable/bg_icon_dark_blue</item>
        <item name="transactionItemBackground">@drawable/bg_transaction_blue</item>
        <item name="keypadRoundedBackground">@drawable/keypad_white_rounded_blue</item>
        <item name="dropdownBackground">@drawable/bg_3d_dropdown_blue</item>
        <item name="cardDarkBackground">@drawable/bg_card_dark_blue</item>
        <item name="searchBackground">@drawable/bg_glass_search_blue</item>
        <item name="roundBackground">@drawable/bg_glass_3d_round</item>
        <item name="borderedRoundBackground">@drawable/bg_glass_3d_round</item>
        <item name="glass3dRedBackground">@drawable/bg_glass_3d_red</item>
        <item name="rigorCalendarBackground">@drawable/bg_glass_panel_blue</item>
        <item name="calendarTheme">@style/CalendarThemeDark</item>
        <item name="textPrimaryColor">@color/text_primary</item>
        <item name="textMutedColor">@color/text_muted</item>
        <item name="navActiveColor">#FFFFFF</item>
        <item name="navInactiveColor">#D0E0FF</item>
        <item name="infoIconBackground">@drawable/bg_white_circle</item>
        <item name="progressTrackColor">#08123A</item>
    </style>


    <style name="Theme.Cashdash.White" parent="Base.Theme.Cashdash">
        <item name="android:autofilledHighlight">@android:color/transparent</item>
        <item name="mainBackground">@drawable/bg_main_gradient_white</item>
        <item name="bottomNavBackground">@drawable/bg_3d_bottom_nav_white</item>
        <item name="cardBackground">@drawable/bg_3d_card_white</item>
        <item name="glass3dBackground">@drawable/bg_glass_3d_white</item>
        <item name="keypadBackground">@drawable/bg_glass_3d_keypad_white</item>
        <item name="inputBackground">@drawable/bg_glass_input_white</item>
        <item name="panelBackground">@drawable/bg_glass_panel_white</item>
        <item name="transactionBackground">@drawable/bg_glass_transaction_white</item>
        <item name="iconBackground">@drawable/bg_icon_dark_white</item>
        <item name="transactionItemBackground">@drawable/bg_transaction_white</item>
        <item name="keypadRoundedBackground">@drawable/keypad_white_rounded_white</item>
        <item name="dropdownBackground">@drawable/bg_3d_dropdown_white</item>
        <item name="cardDarkBackground">@drawable/bg_card_dark_white</item>
        <item name="searchBackground">@drawable/bg_glass_search_white</item>
        <item name="roundBackground">@drawable/bg_glass_3d_round_white</item>
        <item name="glass3dRedBackground">@drawable/bg_glass_3d_red_white</item>
        <item name="borderedRoundBackground">@drawable/bg_glass_3d_round_black_border_white</item>
        <item name="rigorCalendarBackground">@drawable/bg_glass_panel_white</item>
        <item name="calendarTheme">@style/CalendarTheme</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="android:windowBackground">#F8FAFC</item>
        <item name="textPrimaryColor">#1A1A1A</item> <!-- Dark charcoal for primary text -->
        <item name="textMutedColor">#5F6D7E</item>   <!-- Muted gray for secondary text -->
        <item name="navActiveColor">#1A1A1A</item>
        <item name="navInactiveColor">#5F6D7E</item>
        <item name="infoIconBackground">@drawable/bg_white_circle_bordered_white</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="progressTrackColor">#E2E8F0</item>
    </style>





    <!-- Splash Screen Theme: dark bg + custom icon (Android 12+) -->
    <style name="Theme.Cashdash.Splash" parent="Theme.Cashdash">
        <item name="android:windowSplashScreenBackground">@color/app_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_round</item>
    </style>

    <style name="Theme.Cashdash.Blue.Splash" parent="Theme.Cashdash.Blue">
        <item name="android:windowSplashScreenBackground">@color/app_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_round</item>
    </style>

    <!-- 3D POPUP MENU STYLES -->
    <style name="PopupMenu3D" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">?attr/dropdownBackground</item>
        <item name="android:dropDownVerticalOffset">8dp</item>
    </style>

    <style name="PopupMenuTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="popupMenuStyle">@style/PopupMenu3D</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- BOTTOM SHEET STYLE (Transparent background so we can use bg_main_gradient) -->
    <style name="BottomSheetDialogTheme" parent="Theme.Design.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- CalendarTheme: used for White Theme CalendarView (dark text on light bg) -->
    <style name="CalendarTheme" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColorPrimary">#1A1A1A</item>
        <item name="android:textColorSecondary">#1A1A1A</item>
        <item name="android:colorControlNormal">#1A1A1A</item>
        <item name="android:colorControlActivated">#475569</item>
        <item name="android:colorPrimary">@android:color/transparent</item>
        <item name="android:colorAccent">#1A1A1A</item>
        <item name="colorPrimary">@android:color/transparent</item>
        <item name="colorAccent">#1A1A1A</item>
        <item name="android:dateTextAppearance">@style/CalendarDateTextAppearanceWhite</item>
        <item name="android:focusedMonthDateColor">#1A1A1A</item>
    </style>
    
    <style name="CalendarDateTextAppearanceWhite" parent="android:TextAppearance.DeviceDefault.Small">
        <item name="android:textColor">#1A1A1A</item>
    </style>

    <!-- CalendarThemeDark: used for Black/Blue Theme CalendarView (white text on dark bg) -->
    <style name="CalendarThemeDark" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#FFFFFF</item>
        <item name="android:colorControlNormal">#FFFFFF</item>

        <item name="android:colorPrimary">@android:color/transparent</item>
        <item name="android:colorAccent">@android:color/transparent</item>
        <item name="colorAccent">@android:color/transparent</item>
        <item name="colorPrimary">@android:color/transparent</item>
        <item name="android:colorControlActivated">#B39DDB</item>
        <item name="colorControlActivated">#B39DDB</item>
        <item name="android:dateTextAppearance">@style/CalendarDateTextAppearanceDark</item>
        <item name="android:focusedMonthDateColor">#FFFFFF</item>
    </style>

    <style name="CalendarDateTextAppearanceDark" parent="android:TextAppearance.DeviceDefault.Small">
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="FlatListPopup" parent="Widget.AppCompat.ListPopupWindow">
        <item name="android:elevation">0dp</item>
    </style>

    <style name="GlassDialogTheme" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- DatePicker Themes -->

    <style name="DatePickerThemeWhite" parent="Theme.Material3.Light.Dialog">
        <item name="android:colorAccent">#1A1A1A</item>
        <item name="colorPrimary">#1A1A1A</item>
        <item name="android:windowBackground">@drawable/bg_glass_panel_white</item>
        <item name="android:textColorPrimary">#1A1A1A</item>
        <item name="android:textColorSecondary">#475569</item>
        <item name="android:headerBackground">#F1F5F9</item>
        <item name="colorOnPrimary">#1A1A1A</item>
        <item name="android:colorControlActivated">#1A1A1A</item>
        <item name="android:windowIsFloating">true</item>
        <!-- Fix for invisible buttons -->
        <item name="android:buttonBarPositiveButtonStyle">@style/DatePickerButtonWhite</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/DatePickerButtonWhite</item>
    </style>

    <style name="DatePickerButtonWhite" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">#1A1A1A</item>
    </style>
</resources>
