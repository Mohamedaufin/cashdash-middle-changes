<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- NEW DESIGN SYSTEM: Purple & Slate -->
    <!-- Background & Surface -->
    <color name="app_bg">#0D0F12</color>
    <color name="surface">#161A20</color>
    <color name="surface_2">#1F242C</color>
    <color name="border">#2C323C</color>
    <color name="border_white">#CBD5E1</color>
    <color name="surface_white">#F8FAFC</color>

    <!-- Primary Purple -->
    <color name="primary_purple">#7C5CFC</color>
    <!-- Focus / active ring on the Black theme. Deliberately not primary_purple: that
         colour is already the brand accent AND a category in the report pie chart, so a
         focused field read as "brand" rather than "this one is live". Aqua already means
         active here (current-week bar, flashlight on), appears nowhere in the categorical
         palette, and lifts the ring from 3.56:1 to 9.54:1 against the field. -->
    <color name="focus_ring">#4DE1C1</color>
    <!-- Resting border for input fields on the Black theme. Separate from @color/border,
         which is a hairline for dividers and card edges and is deliberately faint: at
         #2C323C it sat at 1.21:1 against the field fill, so an unfocused input had no
         visible edge and read as a floating block rather than a control. This clears the
         3:1 that WCAG 1.4.11 asks of non-text UI without making dividers loud. -->
    <color name="input_border">#6A7485</color>
    <color name="primary_light">#A48AFD</color>
    <color name="primary_dark">#5B3FCC</color>

    <!-- Typography -->
    <color name="text_primary">#F0EFF8</color>
    <color name="text_muted">#7E7D96</color>
    <color name="text_dim">#4A495E</color>

    <!-- Semantic Aliases (to minimize layout changes) -->
    <color name="bg_main">@color/app_bg</color>
    <color name="bg_main_light">@color/surface</color>
    <color name="accent_primary">@color/primary_purple</color>
    <color name="text_secondary">@color/text_muted</color>
    <color name="theme_blue">#1A73E8</color>
</resources>
