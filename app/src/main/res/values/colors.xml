<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- NEW DESIGN SYSTEM: Purple & Slate -->
    <!-- Background & Surface -->
    <color name="app_bg">#0D0F12</color>
    <color name="surface">#161A20</color>
    <color name="surface_2">#1F242C</color>
    <color name="border">#2C323C</color>
    <color name="border_white">#CBD5E1</color>
    <color name="surface_white">#F8FAFC</color>

    <!-- Primary Purple -->
    <color name="primary_purple">#7C5CFC</color>
    <!-- Focus / active ring on the Black theme.
         Not primary_purple: that is the brand accent AND a category in the report pie
         chart, so a focused field read as "brand" rather than "this one is live", and
         could sit beside a slice of the same colour.
         Not a coloured accent either: the Black theme is essentially monochrome, and it
         already says "active" in off-white -- the wallet ring, the current-day bars, the
         selected report tab. This is the same off-white the bars use, so focus speaks the
         language the theme already has instead of importing a hue from outside it.
         Off-white rather than #FFFFFF because pure white on a near-black field halates. -->
    <color name="focus_ring">#EDEFF3</color>
    <color name="primary_light">#A48AFD</color>
    <color name="primary_dark">#5B3FCC</color>

    <!-- Typography -->
    <color name="text_primary">#F0EFF8</color>
    <color name="text_muted">#7E7D96</color>
    <color name="text_dim">#4A495E</color>

    <!-- Semantic Aliases (to minimize layout changes) -->
    <color name="bg_main">@color/app_bg</color>
    <color name="bg_main_light">@color/surface</color>
    <color name="accent_primary">@color/primary_purple</color>
    <color name="text_secondary">@color/text_muted</color>
    <color name="theme_blue">#1A73E8</color>
</resources>
