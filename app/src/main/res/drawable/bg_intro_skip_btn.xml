<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#80FF4D4D"
                android:endColor="#30B20000"
                android:angle="270"
                android:type="linear"/>
            <corners android:radius="6dp"/>
            <stroke
                android:width="0.5dp"
                android:color="#40FF4D4D"/>
        </shape>
    </item>
</layer-list>