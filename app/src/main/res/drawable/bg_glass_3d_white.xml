<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. Silky Base Gradient (EXACT MATCH to Input Bar - White Theme) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#F1F5F9"
                android:endColor="#E2E8F0"
                android:angle="270"
                android:type="linear"/>
            <corners android:radius="16dp"/>
            <stroke
                android:width="1.2dp"
                android:color="@color/border"/> 
        </shape>
    </item>

    <!-- 2. Subtle shadow overlay for depth (Matched to Input Bar) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#05000000" />
        </shape>
    </item>

    <!-- 3. Final Top Gloss (Subtle Button Feel) -->
    <item
        android:bottom="24dp"
        android:left="2dp"
        android:right="2dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#15FFFFFF" 
                android:endColor="#00FFFFFF"
                android:angle="270"
                android:type="linear"/>
            <corners
                android:topLeftRadius="16dp"
                android:topRightRadius="16dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp"/>
        </shape>
    </item>

</layer-list>
