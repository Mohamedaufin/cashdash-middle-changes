<?xml version="1.0" encoding="utf-8"?>
<!--
  Active page dot on the intro tour.

  Filled with ?attr/primaryActionBackground — the same token as the button below it, so the
  two things on the screen that say "here" and "next" are made of the same material. Not the
  green gradient of bg_intro_dot_active: that belongs to the older illustrated intro, and on
  this screen colour is reserved for amounts.

  A rounded rectangle rather than an oval because the dot widens into a pill when it becomes
  active, and an oval would stretch into a lozenge with the wrong end radii.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/primaryActionBackground" />
    <corners android:radius="6dp" />
</shape>
