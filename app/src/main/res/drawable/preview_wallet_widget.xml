<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer ring track (dark) -->
    <item>
        <shape android:shape="oval">
            <stroke android:width="20dp" android:color="#262626" />
            <size android:width="120dp" android:height="120dp" />
        </shape>
    </item>

    <!-- Progress arc approximation (gradient color) -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="60dp"
        android:bottom="60dp">
        <shape android:shape="oval">
            <stroke android:width="20dp" android:color="#00E5FF" />
        </shape>
    </item>

</layer-list>
