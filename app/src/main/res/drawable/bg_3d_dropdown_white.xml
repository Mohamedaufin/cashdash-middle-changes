<?xml version="1.0" encoding="utf-8"?>
<!--
  White theme dropdown / popup menu.

  Was a gradient ending at #F8FAFC with a #40FFFFFF gloss layer over the top. Both push
  toward white, so the popup landed lighter than the page it opened on and read as a
  different material from every other surface. The gloss is a leftover from the dark
  theme, where a white overlay is how you lift a surface; on a light theme it just
  bleaches it.

  Flat surface tone now, same as nav and search.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <padding android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp" />
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#ECEFF4"/>
            <corners android:radius="16dp"/>
            <stroke
                android:width="1.2dp"
                android:color="@color/border_white"/>
        </shape>
    </item>
</layer-list>
