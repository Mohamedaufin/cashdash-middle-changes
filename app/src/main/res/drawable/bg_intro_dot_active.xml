<?xml version="1.0" encoding="utf-8"?>
<!-- Active page dot. A rounded rectangle rather than an oval because the dot widens into a
     pill when it becomes active, and an oval would stretch into a lozenge with the wrong
     end radii. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="8dp" />
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="@color/intro_accent_start"
        android:endColor="@color/intro_accent_end" />
</shape>
