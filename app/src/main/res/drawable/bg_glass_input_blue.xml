<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- FOCUSED STATE -->
    <item android:state_focused="true">
        <layer-list>
            <!-- Deep background with brighter blue glass tint -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient
                        android:startColor="#1A2D8A"
                        android:endColor="#101B54"
                        android:angle="270" />
                    <!-- Subdued inner border -->
                    <stroke
                        android:width="1dp"
                        android:color="#213E99" />
                </shape>
            </item>

            <!-- Frosted bright overlay for focus glow -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#1AFFFFFF" />
                </shape>
            </item>

            <!-- Bright Glowing Outer Rim Light (Focus Indicator) -->
            <item
                android:top="1dp"
                android:left="1dp"
                android:right="1dp"
                android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <stroke
                        android:width="2dp"
                        android:color="#4F79FF" /> <!-- Vibrant neon blue edge -->
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- DEFAULT STATE -->
    <item>
        <layer-list>
            <!-- Deep background with darker glass tint -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient
                        android:startColor="#0D1A5C"
                        android:endColor="#050A2E"
                        android:angle="270" />
                </shape>
            </item>

            <!-- Subtle Frosted overlay -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#0AFFFFFF" />
                </shape>
            </item>

            <!-- Subdued Rim Light (Top & Sides) -->
            <item
                android:top="1dp"
                android:left="1dp"
                android:right="1dp"
                android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#253A7A" /> <!-- Muted blue rim -->
                </shape>
            </item>
        </layer-list>
    </item>
</selector>