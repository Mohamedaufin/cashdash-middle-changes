<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- FOCUSED / SELECTED STATE -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#132268" /> <!-- Slightly darker/distinct for focus -->
        <!-- Lifted from #6E9BFF. Same azure family the theme is built on, but with
             enough presence to read as a state change rather than a shade of the
             navy around it. 4.81:1 -> 6.81:1 against the focused fill. -->
            <stroke
                android:width="1.5dp"
                android:color="#6E9BFF" /> <!-- Brighter blue border for focus -->
        </shape>
    </item>

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#132268" />
            <stroke
                android:width="2.5dp"
                android:color="#6E9BFF" />
        </shape>
    </item>

    <!-- DEFAULT STATE (Solid Colour, matches dropdown) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#0A1340" />
            <stroke
                android:width="1dp"
                android:color="#1E3A8A" />
        </shape>
    </item>

</selector>