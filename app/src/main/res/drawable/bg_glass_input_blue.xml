<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- FOCUSED / SELECTED STATE -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#08103A" /> <!-- Slightly darker/distinct for focus -->
            <stroke
                android:width="1.5dp"
                android:color="#4F79FF" /> <!-- Brighter blue border for focus -->
        </shape>
    </item>

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#08103A" />
            <stroke
                android:width="2.5dp"
                android:color="#4F79FF" />
        </shape>
    </item>

    <!-- DEFAULT STATE (Solid Colour, matches dropdown) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#0A1340" />
            <stroke
                android:width="1dp"
                android:color="#1E3A8A" />
        </shape>
    </item>

</selector>