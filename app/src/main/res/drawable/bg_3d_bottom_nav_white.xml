<?xml version="1.0" encoding="utf-8"?>
<!-- 3D bottom navigation (White Theme): light base + subtle gloss top liner -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Top gloss highlight line (Outer) -->
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#CCD4DF"
                android:endColor="#CCD4DF"
                android:angle="270"
                android:type="linear"/>
        </shape>
    </item>

    <!-- Inner gradient body -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#ECEFF4"
                android:endColor="#ECEFF4"
                android:angle="270"
                android:type="linear"/>
        </shape>
    </item>

</layer-list>