<?xml version="1.0" encoding="utf-8"?>
<!-- Scene two, top of the stack: a disc with a three quarter pie cut into it. Two circles
     offset by (6,6) again, matching ic_intro_coin so the two scenes share a vocabulary. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <path
        android:pathData="M 30,64 A 34,34 0 1 1 98,64 A 34,34 0 1 1 30,64 Z"
        android:fillColor="?attr/introSurfaceDeep"
        android:strokeColor="?attr/introInk"
        android:strokeWidth="2.8" />

    <path
        android:pathData="M 24,58 A 34,34 0 1 1 92,58 A 34,34 0 1 1 24,58 Z"
        android:fillColor="?attr/introSurface"
        android:strokeColor="?attr/introInk"
        android:strokeWidth="2.8" />

    <!-- 270 degrees of pie: out to three o'clock, the long way round to twelve, back in. -->
    <path
        android:pathData="M 58,58 L 76,58 A 18,18 0 1 1 58,40 Z"
        android:fillColor="@color/intro_amber" />
</vector>
