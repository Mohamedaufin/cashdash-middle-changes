<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. Silky Silvery Glass Tint -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E6ECEFF4"/> <!-- 90% White base -->
            <stroke
                android:width="1dp"
                android:color="#20000000"/> <!-- Subdued soft dark rim for visibility -->
        </shape>
    </item>

    <!-- 2. Subtle Left-edge Highlight (Bevel effect) -->
    <item
        android:left="0dp"
        android:right="120dp"
        android:top="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#00FFFFFF" 
                android:endColor="#00FFFFFF"
                android:angle="0"
                android:type="linear"/>
        </shape>
    </item>

</layer-list>
