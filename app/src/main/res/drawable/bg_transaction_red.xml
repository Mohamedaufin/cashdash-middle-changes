<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. Deep Shadow for elevation -->
    <item
        android:left="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#40000000"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>

    <!-- 2. Inner Glow / Glass Tint (Red) -->
    <item
        android:bottom="4dp"
        android:right="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#40FF0000"
                android:endColor="#10FF0000"
                android:angle="135"
                android:type="linear"/>
            <corners android:radius="16dp"/>
            <stroke
                android:width="1.2dp"
                android:color="#80FF4444"/>
        </shape>
    </item>

    <!-- 3. Top-edge Gloss Highlight -->
    <item
        android:bottom="4dp"
        android:right="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#30FFAAAA"
                android:endColor="#00FFFFFF"
                android:centerY="0.2"
                android:angle="270"
                android:type="linear"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
</layer-list>
