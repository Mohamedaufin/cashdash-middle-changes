<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- FOCUSED STATE (White Theme) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:startColor="#FFFFFF"
                android:endColor="#F8FAFC"
                android:angle="270" />
            <stroke
                android:width="2dp"
                android:color="#475569" /> <!-- Softer dark gray for focus -->
        </shape>
    </item>

    <!-- DEFAULT STATE (White Theme) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:startColor="#F1F5F9"
                android:endColor="#E2E8F0"
                android:angle="270" />
            <stroke
                android:width="1.2dp"
                android:color="@color/border_white" /> <!-- Light border for white theme -->
        </shape>
    </item>
</selector>
