<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- FOCUSED / SELECTED STATE (White Theme) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#FFFFFF" />
            <stroke
                android:width="2dp"
                android:color="#475569" />
        </shape>
    </item>

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#FFFFFF" />
            <stroke
                android:width="2.5dp"
                android:color="#475569" />
        </shape>
    </item>

    <!-- DEFAULT STATE (White Theme) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#E8ECF0" />
            <!-- Hardcoded rather than @color/border_white (#CBD5E1), which is shared with
                 other surfaces and sat at 1.25:1 against this fill. Lifting the shared
                 token would have darkened every border on the theme; this clears 3:1 for
                 the input alone. -->
            <stroke
                android:width="1.2dp"
                android:color="#7B8899" />
        </shape>
    </item>
</selector>