<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- FOCUSED / SELECTED STATE (White Theme) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#FFFFFF" />
        <!-- Was #1A73E8, a neutral slate: focus read as "the border got darker and
             thicker" rather than "this field is live", and a dark grey edge does not
             stand out on a light page already full of dark text. #1A73E8 is this
             theme's own link colour, so it introduces nothing new. -->
            <stroke
                android:width="2dp"
                android:color="#1A73E8" />
        </shape>
    </item>

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#FFFFFF" />
            <stroke
                android:width="2.5dp"
                android:color="#1A73E8" />
        </shape>
    </item>

    <!-- DEFAULT STATE (White Theme) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#DDE3EB" />
            <stroke
                android:width="1.2dp"
                android:color="@color/border_white" />
        </shape>
    </item>
</selector>