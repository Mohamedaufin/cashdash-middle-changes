<?xml version="1.0" encoding="utf-8"?>
<!--
  The intro's hero mark: a forward chevron drawn as a sticker, i.e. a coloured face sitting
  slightly proud of a plain plate behind it, both outlined in the theme's ink.

  Both paths are the same outline, offset by (-5, +5) and (+3, -3) from a common centreline
  that runs (38,24) to the tip (86,60) to (38,96) with a half thickness of 13. The round
  ends are 180 degree arcs about each end point and the round tip is a 106 degree arc about
  the tip; the notch is a plain mitre at (64.33, 60), which is where the two inner offset
  lines actually meet for this angle.

  It is a filled outline rather than a thick stroked polyline because a gradient on
  strokeColor and a gradient on fillColor are not equally well travelled, and this shape has
  to carry the gradient.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- The plate behind, offset down and left. -->
    <path
        android:pathData="M 40.8,18.6 L 88.8,54.6 A 13,13 0 0 1 88.8,75.4 L 40.8,111.4 A 13,13 0 0 1 25.2,90.6 L 59.33,65 L 25.2,39.4 A 13,13 0 0 1 40.8,18.6 Z"
        android:fillColor="?attr/introSurface"
        android:strokeColor="?attr/introInk"
        android:strokeWidth="3.2"
        android:strokeLineJoin="round" />

    <!-- The face, offset up and right. -->
    <path
        android:pathData="M 48.8,10.6 L 96.8,46.6 A 13,13 0 0 1 96.8,67.4 L 48.8,103.4 A 13,13 0 0 1 33.2,82.6 L 67.33,57 L 33.2,31.4 A 13,13 0 0 1 48.8,10.6 Z"
        android:strokeColor="?attr/introInk"
        android:strokeWidth="3.2"
        android:strokeLineJoin="round">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="30"
                android:startY="12"
                android:endX="100"
                android:endY="102"
                android:startColor="@color/intro_accent_start"
                android:endColor="@color/intro_accent_end" />
        </aapt:attr>
    </path>
</vector>
