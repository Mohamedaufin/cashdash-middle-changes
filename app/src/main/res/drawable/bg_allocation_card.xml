<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- SELECTED STATE (Clipping Highlight) -->
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#B39DDB"
                        android:endColor="#7C5CFC"
                        android:angle="270" />
                    <corners android:radius="16dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#FFFFFF" />
                </shape>
            </item>
            <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="40dp">
                <shape android:shape="rectangle">
                    <solid android:color="#20000000" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- FOCUSED STATE -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/surface_2" />
                    <corners android:radius="16dp" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/primary_purple" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- DEFAULT STATE (Matches bg_glass_input) -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/surface_2" />
                    <corners android:radius="16dp" />
                    <stroke
                        android:width="1.2dp"
                        android:color="@color/border" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
