<?xml version="1.0" encoding="utf-8"?>
<!--
  Black theme input / chip background.

  Flat shapes, one layer per state, matching bg_glass_input_blue. This used to be a
  layer-list per state with a white gradient laid over the base to fake a lit bevel,
  plus a coloured inner glow on focus. The glow existed to compensate for the fill
  never changing: the border was the only thing that moved, so it needed help.

  Focus now moves two things at once, as Blue and White already did - the fill drops
  away from the resting tone and the stroke comes up in the focus colour. With both
  cues present the glow is redundant, and dropping it removes the plastic bevel look
  along with it.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- FOCUSED -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#191E25" />
            <stroke
                android:width="2dp"
                android:color="@color/focus_ring" />
        </shape>
    </item>

    <!-- SELECTED (chips) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#191E25" />
            <stroke
                android:width="2.5dp"
                android:color="@color/focus_ring" />
        </shape>
    </item>

    <!-- DEFAULT -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/surface_2" />
            <stroke
                android:width="1.2dp"
                android:color="@color/border" />
        </shape>
    </item>
</selector>
