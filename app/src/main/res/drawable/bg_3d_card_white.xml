<?xml version="1.0" encoding="utf-8"?>
<!--
  White theme card.

  Was a #E8ECF0 fill with an opaque #000000 1dp stroke. Two problems at once: the fill
  was darker than the page it sat on, and a hard black outline on a light card is the
  single most dated thing in a light UI. It reads as a wireframe rather than a surface.

  Now white on the grey page, with a soft border. The card is defined by being lighter
  than its surroundings, and the border only finishes the edge.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFF"/>
    <corners android:radius="20dp"/>
    <stroke
        android:width="1dp"
        android:color="#DFE4EB"/>
</shape>
