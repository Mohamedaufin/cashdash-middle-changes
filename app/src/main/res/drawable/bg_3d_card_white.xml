<?xml version="1.0" encoding="utf-8"?>
<!--
  White theme card.

  Part of a single tonal family, mirroring how the Black theme is built. There, every
  surface sits within 1.49:1 of the page and nothing has a hard edge, which is what makes
  it read as one material. White was doing the opposite: an opaque #000000 outline at
  19.2:1 against the page, so each card was a separate cut-out rather than part of a
  system.

  The card is now one step off the page (1.10:1) with a border at 1.42:1, the same
  relationships Black uses, inverted for light: the page is the lightest thing and
  surfaces step down from it.

  Do not reintroduce a black stroke here without changing the rest of the theme with it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#EAEEF3"/>
    <corners android:radius="20dp"/>
    <stroke
        android:width="1dp"
        android:color="@color/border_white"/>
</shape>
