<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base: Pure white fill matching card background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="14dp"/>
            <!-- Soft muted rose border — noticeable but not harsh -->
            <stroke
                android:width="1.5dp"
                android:color="#F08080"/>
        </shape>
    </item>

    <!-- Subtle warm rose wash at the top only -->
    <item
        android:bottom="36dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#12FF4444"
                android:endColor="#00FFFFFF"
                android:angle="270"
                android:type="linear"/>
            <corners
                android:topLeftRadius="14dp"
                android:topRightRadius="14dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp"/>
        </shape>
    </item>

</layer-list>
