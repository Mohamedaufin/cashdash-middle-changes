<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base: Silky Rose Red (Layered 2D) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#F43F5E" 
                android:endColor="#E11D48"
                android:angle="270" />
            <corners android:radius="14dp"/>
            <stroke
                android:width="1.2dp"
                android:color="#9F1239"/> 
        </shape>
    </item>
    <!-- Subdued top-down inner glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#30FFFFFF" 
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
