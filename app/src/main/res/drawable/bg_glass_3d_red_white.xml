<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. Silky Base Gradient (Vibrant Red) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#F43F5E" 
                android:endColor="#E11D48"
                android:angle="270"
                android:type="linear"/>
            <corners android:radius="14dp"/>
            <!-- Sharp Contrast Border -->
            <stroke
                android:width="1.2dp"
                android:color="#9F1239"/> 
        </shape>
    </item>

    <!-- 2. Subtle shadow overlay for depth -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#10000000" />
        </shape>
    </item>

    <!-- 3. Final Top Gloss (Subtle Premium Feel) -->
    <item
        android:bottom="14dp"
        android:left="2dp"
        android:right="2dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#30FFFFFF" 
                android:endColor="#00FFFFFF"
                android:angle="270"
                android:type="linear"/>
            <corners
                android:topLeftRadius="14dp"
                android:topRightRadius="14dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>

</layer-list>
