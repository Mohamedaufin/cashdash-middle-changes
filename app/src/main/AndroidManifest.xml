<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 🔥 Core Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Usage Stats for tracking which app is open -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    
    <!-- Foreground Service permissions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Overlay permission for Smart Shopping Assistant -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />


    
    <!-- 📷 Hardware features -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- 🔍 Declare UPI apps (queries section) -->
    <queries>
        <package android:name="com.dreamplug.androidapp" /> <!-- CRED -->
        <package android:name="com.google.android.apps.nbu.paisa.user" /> <!-- GPay -->
    </queries>

    <application
        android:name=".CashDashApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cashdash"
        tools:targetApi="31">
        
        <!-- 🔥 Firebase Notifications: Default Headers (Master Fix) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="cashdash_urgent_heads_up_v10" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_bell" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/white" />

        <meta-data
            android:name="com.google.mlkit.vision.dependencies"
            android:value="barcode" />

        <!-- 🚀 Launcher Activity -->
        <activity
            android:name=".AdminActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AdminLogsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SplashActivity"
            android:theme="@style/Theme.Cashdash.Splash"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".EntryActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <!-- 🏠 Main Flow Activities -->
        <activity android:name=".MainActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".AllocatorActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".SetLimitActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".ProfileActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".MenuActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".TaptrackActivity" android:screenOrientation="portrait" android:exported="false" />


        <activity android:name=".MoneyScheduleActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".HistoryActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".RigorActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".CategoryAnalysisActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".SearchActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".DetailHistoryActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".BalanceSetupActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".HelpActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".SuccessActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".ThemeActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".ReportActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".StatementActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".StatementSelectionActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".WebViewActivity" android:screenOrientation="portrait" android:exported="false" />

        <activity 
            android:name=".NotificationActivity" 
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="NotificationActivity" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 📷 QR Scanner + Deep Link -->
        <activity
            android:name=".ScannerActivity"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="cashdash" />
            </intent-filter>
        </activity>



        <receiver
            android:name=".ScannerWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/scanner_widget_info" />
        </receiver>

        <!-- 🔥 Firebase Cloud Messaging Service -->
        <service
            android:name=".MyFirebaseMessagingService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>


        <receiver
            android:name=".TrackerWidget"
            android:label="CashDash Tracker"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tracker_widget_info" />
        </receiver>

        <activity
            android:name=".WidgetLaunchActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="false" />

        <service
            android:name=".AppUsageTrackerService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                      android:value="Tracks active package to display financial overlay over shopping apps"/>
        </service>

        <!-- Floating Widget Service -->
        <service
            android:name=".FloatingWidgetService"
            android:exported="false" />

    </application>

</manifest>
