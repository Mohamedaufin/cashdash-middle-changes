<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 🔥 Core Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Usage Stats for tracking which app is open -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    
    <!-- Foreground Service permissions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Overlay permission for Smart Shopping Assistant -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />


    
    <!-- 📷 Hardware features -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- 🔍 Declare UPI apps (queries section) -->
    <queries>
        <package android:name="com.dreamplug.androidapp" /> <!-- CRED -->
    </queries>

    <application
        android:name=".CashDashApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cashdash"
        tools:targetApi="31">
        
        <!-- 🔥 Firebase Notifications: Default Headers (Master Fix) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="cashdash_urgent_heads_up_v10" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_bell" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/white" />

        <meta-data
            android:name="com.google.mlkit.vision.dependencies"
            android:value="barcode" />

        <!-- 🚀 Launcher Activity -->
        <activity android:configChanges="uiMode"
            android:name=".AdminActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity android:configChanges="uiMode"
            android:name=".AdminLogsActivity"
            android:screenOrientation="portrait"
            android:exported="false"
             />

        <activity android:configChanges="uiMode"
            android:name=".SplashActivity"
            android:theme="@style/Theme.Cashdash.Splash"
            
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:configChanges="uiMode"
            android:name=".AdminMessagingActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity android:configChanges="uiMode"
            android:name=".EntryActivity"
            
            android:exported="false" />

        <!-- 🏠 Main Flow Activities -->
        <activity android:configChanges="uiMode" android:name=".MainActivity"  android:exported="false" />
        <activity android:configChanges="uiMode" android:name=".AllocatorActivity"  android:exported="false" />
        <activity android:configChanges="uiMode" android:name=".SetLimitActivity"  android:exported="false" />
        <activity android:configChanges="uiMode" android:name=".ProfileActivity"  android:exported="false" />
        <activity android:configChanges="uiMode" android:name=".MenuActivity"  android:exported="false" />
        <activity android:configChanges="uiMode" android:name=".TaptrackActivity"  android:exported="false" />


        <activity android:configChanges="uiMode" android:name=".MoneyScheduleActivity"  android:exported="false" />
        <activity android:configChanges="uiMode" android:name=".HistoryActivity"  android:exported="false" />
        <activity android:configChanges="uiMode" android:name=".RigorActivity"  android:exported="false" />
        <activity android:configChanges="uiMode" android:name=".CategoryAnalysisActivity"  android:exported="false" />
        <activity android:configChanges="uiMode" android:name=".SearchActivity"  android:exported="false" />
        <activity android:configChanges="uiMode" android:name=".DetailHistoryActivity"  android:exported="false" />
        <activity android:configChanges="uiMode" android:name=".BalanceSetupActivity"  android:exported="false" />
        <activity android:configChanges="uiMode" android:name=".HelpActivity"  android:exported="false" />
        <activity android:configChanges="uiMode" android:name=".ContactSupportActivity"  android:exported="false" />
        <activity android:configChanges="uiMode" android:name=".SuccessActivity"  android:exported="false" />
        <activity android:configChanges="uiMode" android:name=".ThemeActivity"  android:exported="false" />
        <activity android:configChanges="uiMode" android:name=".ReportActivity"  android:exported="false" />
        <activity android:configChanges="uiMode" android:name=".StatementActivity"  android:exported="false" />
        <activity android:configChanges="uiMode" android:name=".StatementSelectionActivity"  android:exported="false" />
        <activity android:configChanges="uiMode" android:name=".WebViewActivity"  android:exported="false" />
        <activity android:configChanges="uiMode" android:name=".FinminderActivity"  android:exported="false" />
        <activity android:configChanges="uiMode" android:name=".AddFinminderActivity"  android:exported="false" />
        <activity android:configChanges="uiMode" android:name=".AdminPromotionsActivity" android:screenOrientation="portrait" android:exported="false" />

        <activity android:configChanges="uiMode" 
            android:name=".NotificationActivity" 
            android:exported="true"
            android:launchMode="singleTop"
            
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="NotificationActivity" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 📷 QR Scanner + Deep Link -->
        <activity android:configChanges="uiMode"
            android:name=".ScannerActivity"
            
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="cashdash" />
            </intent-filter>
        </activity>



        <receiver
            android:name=".ScannerWidget"
            android:label="CashDash Scanner"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/scanner_widget_info" />
        </receiver>

        <receiver
            android:name=".ScannerWidgetPinReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".WalletWidgetPinReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".Finminder"
            android:label="Finminder"
            android:icon="@drawable/ic_finminder_preview"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.cash.dash.ACTION_NEXT" />
                <action android:name="com.cash.dash.ACTION_PREV" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/wallet_widget_info" />
        </receiver>

        <!-- 🔥 Firebase Cloud Messaging Service -->
        <service
            android:name=".MyFirebaseMessagingService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>


        <receiver
            android:name=".TrackerWidget"
            android:label="CashDash Tracker"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tracker_widget_info" />
        </receiver>

        <receiver
            android:name=".TaptrackWidget"
            android:label="TapTrack"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.cash.dash.TAPTRACK_WIDGET_TOGGLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/taptrack_widget_info" />
        </receiver>

        <receiver
            android:name=".TaptrackWidgetPinReceiver"
            android:enabled="true"
            android:exported="false" />


        <activity android:configChanges="uiMode"
            android:name=".WidgetLaunchActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="false" />

        <service
            android:name=".AppUsageTrackerService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                      android:value="Tracks active package to display financial overlay over shopping apps"/>
        </service>

        <!-- Floating Widget Service -->
        <service
            android:name=".FloatingWidgetService"
            android:exported="false" />

        <!-- Task Monitor Service to handle swipe-to-close presence tracking -->
        <service
            android:name=".TaskMonitorService"
            android:exported="false" />

        <receiver
            android:name=".PaymentRecoveryReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.cash.dash.PAYMENT_YES" />
                <action android:name="com.cash.dash.PAYMENT_NO" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".PaymentRecoveryAlarmReceiver"
            android:exported="false" />        <activity
            android:name=".NotificationActionReceiver"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:exported="false">
            <intent-filter>
                <action android:name="com.cash.dash.ACTION_OPEN_URL" />
            </intent-filter>
        </activity>

        <!-- Override MLKit library's portrait lock for Android 16 compatibility -->
        <activity
            android:name="com.google.mlkit.vision.codescanner.internal.GmsBarcodeScanningDelegateActivity"
            tools:node="merge"
            tools:remove="screenOrientation" />

    </application>

</manifest>
