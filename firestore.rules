rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is signed in and their email matches the document ID
    function isOwner(emailId) {
      return request.auth != null && request.auth.token.email == emailId;
    }

    // Match the users collection and the specific user's document
    match /users/{userEmail} {
      allow read, write: if isOwner(userEmail);

      // Match all subcollections under the user's document
      match /{subcollection=**} {
        allow read, write: if isOwner(userEmail);
      }
    }

    // Match the deleted_accounts collection
    match /deleted_accounts/{userEmail} {
      allow read, write: if isOwner(userEmail);
    }

    // 🚀 NEW: Match the Admin Announcements collection
    match /announcements/{document=**} {
      // Allow any logged-in user to read the announcements
      allow read: if request.auth != null;
      
      // ONLY allow your specific admin emails to publish or edit announcements
      allow write: if request.auth != null && (request.auth.token.email == "mohamedaufin64@gmail.com" || request.auth.token.email == "arunbhalaji200904@gmail.com");
    }

    // 🚀 NEW: Match the Global Pushes collection
    match /global_pushes/{document=**} {
      allow read: if request.auth != null;
      
      // ONLY allow your specific admin emails to send global push notifications
      allow write: if request.auth != null && (request.auth.token.email == "mohamedaufin64@gmail.com" || request.auth.token.email == "arunbhalaji200904@gmail.com");
    }
  }
}
