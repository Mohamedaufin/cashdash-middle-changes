rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    // Check if the requester is signed in and is the owner of the document (by email)
    function isOwner(emailId) {
      return request.auth != null && request.auth.token.email.lower() == emailId.lower();
    }

    // Super admins (owners) — hardcoded by email
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email.lower() == "mohamedaufin64@gmail.com" ||
        request.auth.token.email.lower() == "arunbhalaji200904@gmail.com"
      );
    }

    // Admins who specifically have the 'allocateAdmins' permission granted
    function hasAllocateAdminPermission() {
      return request.auth != null && (
        isSuperAdmin() ||
        (
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) &&
          get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.allocateAdmins == true
        )
      );
    }

    // Any user who is listed in the admins collection OR is a super admin
    function isAnyAdmin() {
      return request.auth != null && (
        isSuperAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))
      );
    }

    // Check the user's account is not suspended/deleted
    function isActiveUser() {
      return request.auth != null;
    }

    // --- Collection Rules ---

    // User documents: owners can manage their own, admins can read all
    match /users/{userEmail} {
      allow read: if isOwner(userEmail) || isAnyAdmin();
      allow write: if isOwner(userEmail);

      // Subcollections (config, notifications, etc.)
      match /{subcollection=**} {
        allow read: if isOwner(userEmail) || isAnyAdmin();
        allow write: if isOwner(userEmail);
      }
    }

    // Deleted accounts: users can read their own (for self-deletion flow), only super admins can write
    match /deleted_accounts/{userEmail} {
      allow read: if isOwner(userEmail) || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // Admins collection
    // READ: any admin can read (needed to load admin management screens)
    // WRITE: only admins with allocateAdmins permission or super admins can modify
    match /admins/{adminEmail} {
      allow read: if isAnyAdmin();
      allow write: if hasAllocateAdminPermission();
    }

    // Admin requests (pending admin promotions)
    // READ: any admin can view pending requests
    // WRITE: only admins with allocateAdmins permission can process them
    match /admin_requests/{requestEmail} {
      allow read: if isAnyAdmin();
      allow write: if hasAllocateAdminPermission();
    }

    // Announcements: any signed-in user can read, only admins can write
    match /announcements/{document=**} {
      allow read: if isActiveUser();
      allow write: if isAnyAdmin();
    }

    // Global push notifications: any signed-in user can read, only admins can write
    match /global_pushes/{document=**} {
      allow read: if isActiveUser();
      allow write: if isAnyAdmin();
    }

    // User-targeted push notifications: any signed-in user can read their own, only admins can write
    match /user_pushes/{document=**} {
      allow read: if isActiveUser();
      allow write: if isAnyAdmin();
    }

    // Admin action logs: only admins can read/write
    // Exception: any signed-in user can append their own click to notif_clickers/ann_clickers only
    match /admin_logs/{document=**} {
      allow read, write: if isAnyAdmin();
      allow update: if isActiveUser() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notif_clickers', 'ann_clickers']);
    }

    // Audit logs: written by the app when admin actions occur
    // Only super admins can read; any admin (or the app acting as admin) can append
    match /audit_logs/{document=**} {
      allow read: if isSuperAdmin();
      allow create: if isAnyAdmin();
      allow update, delete: if isSuperAdmin();
    }

    // System configuration (e.g. app update lock settings)
    // READ: any signed-in user (needed to check if update is required on splash)
    // WRITE: only admins
    match /system/{document=**} {
      allow read: if isActiveUser();
      allow write: if isAnyAdmin();
    }

    // Deny everything else by default (implicit, but explicit is safer)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
