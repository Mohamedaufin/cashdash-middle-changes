rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    // Check if the requester is signed in and is the owner of the document (by email)
    function isOwner(emailId) {
      return request.auth != null && request.auth.token.email.lower() == emailId.lower();
    }

    // Super admins (owners) — hardcoded by email
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email.lower() == "mohamedaufin64@gmail.com" ||
        request.auth.token.email.lower() == "arunbhalaji200904@gmail.com"
      );
    }

    function adminExists() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    function adminData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data;
    }

    // An admin whose validUntil has passed is no longer an admin. This used to be
    // checked only in the Kotlin client, which meant expired admins kept full
    // server-side access to every user's data.
    function adminNotExpired() {
      return adminData().get('validUntil', 0) == 0 ||
             adminData().get('validUntil', 0) > request.time.toMillis();
    }

    // Any user who is a current, unexpired admin OR is a super admin
    function isAnyAdmin() {
      return isSuperAdmin() || (adminExists() && adminNotExpired());
    }

    // Grants that imply every other permission
    function adminHasBlanket() {
      return adminData().get('isOwner', false) == true ||
             adminData().get('fullAccess', false) == true;
    }

    // --- Granular permissions ---
    // These mirror AdminManager.AdminPermissions in the app. They used to be
    // enforced only in the client, so any admin could read anything.

    function canReplyToQueries() {
      return isSuperAdmin() || (adminExists() && adminNotExpired() &&
        (adminHasBlanket() || adminData().get('replyToQueries', false) == true));
    }

    function canViewLastSeen() {
      return isSuperAdmin() || (adminExists() && adminNotExpired() &&
        (adminHasBlanket() || adminData().get('viewLastSeen', false) == true));
    }

    function canViewAdminLogs() {
      return isSuperAdmin() || (adminExists() && adminNotExpired() &&
        (adminHasBlanket() || adminData().get('viewAdminLogs', false) == true));
    }

    function canAllocateAdmins() {
      return isSuperAdmin() || (adminExists() && adminNotExpired() &&
        (adminHasBlanket() || adminData().get('allocateAdmins', false) == true));
    }

    function canBroadcast() {
      return isSuperAdmin() || (adminExists() && adminNotExpired() && (
        adminHasBlanket() ||
        adminData().get('sendAnnouncements', false) == true ||
        adminData().get('sendPromotions', false) == true ||
        adminData().get('sendNotifications', false) == true
      ));
    }

    // Check the user's account is not suspended/deleted
    function isActiveUser() {
      return request.auth != null;
    }

    // --- Collection Rules ---

    match /users/{userEmail} {
      // The top-level user doc holds name + fcmToken, and admins need to list this
      // collection to build the support inbox.
      allow read: if isOwner(userEmail) || isAnyAdmin();
      allow write: if isOwner(userEmail);

      // Support threads: readable by admins who actually handle queries.
      match /notifications/{notificationId} {
        allow read: if isOwner(userEmail) || canReplyToQueries();
        allow write: if isOwner(userEmail);
      }

      // Name / phone card shown in the admin screens.
      match /config/profile {
        allow read: if isOwner(userEmail) || isAnyAdmin();
        allow write: if isOwner(userEmail);
      }

      // Everything else under config is the user's financial data — wallet,
      // history, analytics, categories, finminder, upi_allocations. Owner only.
      // Admins previously had blanket read over all of this.
      match /config/{docId} {
        allow read, write: if isOwner(userEmail);
      }

      // Any other subcollection — owner only.
      match /{subcollection}/{docId=**} {
        allow read, write: if isOwner(userEmail);
      }
    }

    // Deleted accounts: users can read their own (for self-deletion flow), only super admins can write
    match /deleted_accounts/{userEmail} {
      allow read: if isOwner(userEmail) || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // Admins collection
    // READ: any current admin can read (needed to load admin management screens)
    // WRITE: super admins without restriction; allocateAdmins holders may manage
    //        OTHER admins only, and may not mint new owners. This blocks the
    //        self-escalation path where an allocateAdmins holder wrote isOwner:true
    //        onto their own document.
    match /admins/{adminEmail} {
      allow read: if isAnyAdmin();

      allow create, update: if isSuperAdmin() || (
        canAllocateAdmins() &&
        adminEmail.lower() != request.auth.token.email.lower() &&
        request.resource.data.get('isOwner', false) != true
      );

      allow delete: if isSuperAdmin() || (
        canAllocateAdmins() &&
        adminEmail.lower() != request.auth.token.email.lower()
      );
    }

    // Admin requests (pending admin promotions)
    match /admin_requests/{requestEmail} {
      allow read: if isAnyAdmin();
      allow write: if canAllocateAdmins();
    }

    // Announcements: any signed-in user can read, only broadcasting admins can write
    match /announcements/{document=**} {
      allow read: if isActiveUser();
      allow write: if canBroadcast();
    }

    // Global push notifications
    match /global_pushes/{document=**} {
      allow read: if isActiveUser();
      allow write: if canBroadcast();
    }

    // User-targeted push notifications
    match /user_pushes/{document=**} {
      allow read: if isActiveUser();
      allow write: if canBroadcast();
    }

    // Admin action logs.
    // Exception: a signed-in user may APPEND THEIR OWN EMAIL to the click arrays
    // and nothing else. Previously `hasOnly` constrained which keys changed but
    // not how, so any user could overwrite or wipe the arrays wholesale.
    match /admin_logs/{document=**} {
      allow read, write: if isAnyAdmin();

      allow update: if isActiveUser()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['notif_clickers', 'ann_clickers'])
        && request.resource.data.get('notif_clickers', [])
             .removeAll(resource.data.get('notif_clickers', []))
             .hasOnly([request.auth.token.email])
        && resource.data.get('notif_clickers', [])
             .removeAll(request.resource.data.get('notif_clickers', []))
             .size() == 0
        && request.resource.data.get('ann_clickers', [])
             .removeAll(resource.data.get('ann_clickers', []))
             .hasOnly([request.auth.token.email])
        && resource.data.get('ann_clickers', [])
             .removeAll(request.resource.data.get('ann_clickers', []))
             .size() == 0;
    }

    // Audit logs: written by the app when admin actions occur.
    // Clients may still create, but only entries naming themselves as actor with
    // a server timestamp — so cross-admin forgery is blocked without needing to
    // move the write into a Cloud Function.
    match /audit_logs/{document=**} {
      allow read: if isSuperAdmin();
      allow create: if isAnyAdmin()
        && request.resource.data.actor_email == request.auth.token.email.lower()
        && request.resource.data.timestamp == request.time;
      allow update, delete: if isSuperAdmin();
    }

    // System configuration (e.g. app update lock settings)
    // READ: any signed-in user (needed to check if update is required on splash)
    // WRITE: only admins
    match /system/{document=**} {
      allow read: if isActiveUser();
      allow write: if isAnyAdmin();
    }

    // Server-side rate limit counters, written only by Cloud Functions (admin SDK).
    match /rate_limits/{document=**} {
      allow read, write: if false;
    }

    // Deny everything else by default (implicit, but explicit is safer)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
